@* Top navigation bar for the Sample Web app *@
<nav class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-violet-300/30 bg-gradient-to-br from-violet-400/30 to-indigo-400/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]" aria-hidden="true">🗃</span>
        <span class="text-sm font-semibold tracking-wide text-slate-100">@AppName</span>
        <span class="hidden rounded-full border border-violet-300/35 bg-violet-500/20 px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-violet-100 sm:inline-flex">Aspire Sample</span>
    </div>

    <button class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 bg-slate-900/60 text-slate-100 sm:hidden"
            aria-label="Toggle navigation"
            @onclick="ToggleMenu">
        <span class="text-lg leading-none">☰</span>
    </button>

    <ul class="@GetLinksClasses()">
        @foreach (var link in Links)
        {
            <li>
                <NavLink class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-white/10 hover:text-white"
                         href="@link.Href"
                         Match="@(link.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         ActiveClass="bg-violet-500/20 text-violet-100 ring-1 ring-violet-300/45"
                         @onclick="CloseMenu">
                    @if (!string.IsNullOrEmpty(link.Icon))
                    {
                        <span aria-hidden="true">@link.Icon</span>
                    }
                    @link.Label
                </NavLink>
            </li>
        }
    </ul>
    </div>
</nav>

@code {
    [Parameter]
    public string AppName { get; set; } = "DataExplorer Sample";

    [Parameter]
    public IReadOnlyList<NavLinkItem> Links { get; set; } = [];

    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private string GetLinksClasses()
        => _menuOpen
            ? "absolute left-0 right-0 top-16 z-50 m-0 flex list-none flex-col gap-2 border-b border-white/10 bg-slate-950/95 p-4 shadow-2xl sm:static sm:z-auto sm:flex-row sm:items-center sm:gap-1 sm:border-none sm:bg-transparent sm:p-0 sm:shadow-none"
            : "hidden list-none gap-1 sm:flex sm:items-center sm:m-0 sm:p-0";

    public record NavLinkItem(string Label, string Href, string Icon = "", bool Exact = false);
}

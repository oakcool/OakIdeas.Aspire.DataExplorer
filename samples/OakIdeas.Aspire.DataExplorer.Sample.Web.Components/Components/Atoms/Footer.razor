@* Application footer *@
<footer class="mt-auto border-t border-white/10 bg-slate-950/80">
    <div class="mx-auto flex w-full max-w-7xl flex-col items-center gap-2 px-4 py-6 text-center sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 text-sm font-semibold text-slate-200">
            <span aria-hidden="true">🗃</span>
            <span>@AppName</span>
        </div>
        <p class="m-0 text-xs text-slate-400">
            Powered by <strong>.NET Aspire</strong> &amp; <strong>OakIdeas.Aspire.DataExplorer</strong> · Development Sample
        </p>
        <p class="m-0 text-[0.72rem] text-slate-500">
            This is a demonstration application. Do not use in production.
        </p>
    </div>
</footer>

@code {
    [Parameter]
    public string AppName { get; set; } = "DataExplorer Sample";
}

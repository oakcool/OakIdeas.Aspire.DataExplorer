@* Inline loading state placeholder *@
<div class="sample-surface flex flex-col items-center justify-center gap-4 px-6 py-10 text-center" role="status">
    <div class="h-10 w-10 animate-spin rounded-full border-4 border-violet-300/25 border-t-violet-300"></div>
    <p class="m-0 text-sm font-medium text-slate-300">@Label</p>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "Loading…";
}

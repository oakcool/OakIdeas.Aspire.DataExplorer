@* Compact stat widget card *@
<div class="sample-surface flex items-center gap-4 px-4 py-4">
    <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl ring-1 ring-white/35" style="background-color: @IconBg">
        <span class="text-xl" aria-hidden="true">@Icon</span>
    </div>
    <div class="flex flex-col gap-0.5">
        <span class="text-xl font-black leading-none text-white">@Value</span>
        <span class="text-xs font-semibold uppercase tracking-[0.08em] text-slate-300">@Label</span>
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = "—";

    [Parameter]
    public string Icon { get; set; } = "📊";

    [Parameter]
    public string IconBg { get; set; } = "#dbeafe";
}

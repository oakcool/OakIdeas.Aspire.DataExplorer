@* Hero section for the Sample home page *@
<section class="relative overflow-hidden border-b border-white/10 pb-14 pt-12">
    <div class="pointer-events-none absolute -left-20 top-0 h-72 w-72 rounded-full bg-violet-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-20 top-20 h-64 w-64 rounded-full bg-pink-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
    <div class="relative z-10 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2">
            <Badge Text=".NET Aspire" Variant="info" />
            <Badge Text="Development Tool" Variant="warning" />
        </div>
        <h1 class="m-0 text-balance text-4xl font-black tracking-tight text-white sm:text-5xl">@Headline</h1>
        <p class="m-0 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">@SubText</p>
        <div class="flex flex-wrap gap-3">
            @Actions
        </div>
    </div>
    <div class="relative z-10 hidden lg:flex lg:justify-end" aria-hidden="true">
        <div class="sample-surface w-full max-w-xl overflow-hidden">
            <div class="flex items-center gap-2 border-b border-white/10 bg-slate-900/80 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                <span class="ml-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Query preview</span>
            </div>
            <pre class="m-0 overflow-x-auto px-4 py-4 font-mono text-xs leading-7 text-violet-100">SELECT TOP 5
  Id, Title, IsCompleted
FROM dbo.TodoItems
WHERE IsCompleted = 0
ORDER BY CreatedAt DESC;</pre>
        </div>
    </div>
    </div>
</section>

@code {
    [Parameter]
    public string Headline { get; set; } = "Explore Your Aspire Databases";

    [Parameter]
    public string SubText { get; set; } = "A development-time companion for inspecting and querying SQL Server databases registered with .NET Aspire.";

    [Parameter]
    public RenderFragment? Actions { get; set; }
}

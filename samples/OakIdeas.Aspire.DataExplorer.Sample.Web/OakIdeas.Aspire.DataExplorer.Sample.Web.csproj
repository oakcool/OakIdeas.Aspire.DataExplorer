<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		<UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Sample.Web.Components\OakIdeas.Aspire.DataExplorer.Sample.Web.Components.csproj" />
  </ItemGroup>

	<!-- Tailwind CSS build integration -->
	<Target Name="NpmInstallIfNeeded" BeforeTargets="BuildTailwindCss" Inputs="$(MSBuildProjectDirectory)/package.json" Outputs="$(MSBuildProjectDirectory)/node_modules/.package-lock.json">
		<Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<Target Name="BuildTailwindCss" BeforeTargets="Build" Inputs="$(MSBuildProjectDirectory)/Styles/app.css;@(Content)" Outputs="$(MSBuildProjectDirectory)/wwwroot/app.css">
		<Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<ItemGroup>
		<None Include="Styles/**" />
		<None Include="package.json" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\css\" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.3.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.3.2" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.3.2" />
  </ItemGroup>

  <PropertyGroup>
    <DataExplorerLocalPublishedAppDir>$(MSBuildProjectDirectory)\..\..\src\OakIdeas.Aspire.DataExplorer.Hosting\DataExplorerWeb\publish\</DataExplorerLocalPublishedAppDir>
    <UserSecretsId>454f13de-9214-4e3a-9d98-f76182b35e21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OakIdeas.Aspire.DataExplorer.Hosting\OakIdeas.Aspire.DataExplorer.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Sample.Api\OakIdeas.Aspire.DataExplorer.Sample.Api.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Sample.Web\OakIdeas.Aspire.DataExplorer.Sample.Web.csproj" />
  </ItemGroup>

  <Target Name="CopyLocalDataExplorerWebApp" AfterTargets="Build" Condition="Exists('$(DataExplorerLocalPublishedAppDir)')">
    <RemoveDir Directories="$(TargetDir)data-explorer-web"
           Condition="Exists('$(TargetDir)data-explorer-web')"
           ContinueOnError="WarnAndContinue" />

    <ItemGroup>
      <_LocalDataExplorerOldScopedCssBundles Include="$(TargetDir)data-explorer-web\wwwroot\_content\OakIdeas.Aspire.DataExplorer.Web.Components\*.bundle.scp.css" />
      <_LocalDataExplorerOldScopedCssBundles Include="$(TargetDir)data-explorer-web\wwwroot\_content\OakIdeas.Aspire.DataExplorer.Web.Components\*.bundle.scp.css.br" />
      <_LocalDataExplorerOldScopedCssBundles Include="$(TargetDir)data-explorer-web\wwwroot\_content\OakIdeas.Aspire.DataExplorer.Web.Components\*.bundle.scp.css.gz" />
    </ItemGroup>

    <Delete Files="@(_LocalDataExplorerOldScopedCssBundles)" ContinueOnError="WarnAndContinue" />

    <ItemGroup>
    <_LocalDataExplorerPublishedFiles Include="$(DataExplorerLocalPublishedAppDir)**\*.*" />
    <_LocalDataExplorerPublishedDirectories Include="@(_LocalDataExplorerPublishedFiles->'$(TargetDir)data-explorer-web\%(RecursiveDir)')" />
    </ItemGroup>

    <MakeDir Directories="@(_LocalDataExplorerPublishedDirectories)" />

    <Copy SourceFiles="@(_LocalDataExplorerPublishedFiles)" DestinationFiles="@(_LocalDataExplorerPublishedFiles->'$(TargetDir)data-explorer-web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>

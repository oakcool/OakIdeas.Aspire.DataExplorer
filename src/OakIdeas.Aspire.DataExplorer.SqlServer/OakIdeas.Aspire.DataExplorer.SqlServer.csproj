<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Core\OakIdeas.Aspire.DataExplorer.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Contracts\OakIdeas.Aspire.DataExplorer.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Data\OakIdeas.Aspire.DataExplorer.Data.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OakIdeas.Aspire.DataExplorer" VersionOverride="$(Version)" Condition="'$(IncludeCorePackageDependency)' == 'true'" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Aspire.Hosting" Version="13.4.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeCorePackageDependency>false</IncludeCorePackageDependency>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OakIdeas.Aspire.DataExplorer.SqlServer</PackageId>
    <Title>OakIdeas Aspire Data Explorer SQL Server Provider</Title>
    <Description>SQL Server metadata discovery and query provider for OakIdeas Aspire Data Explorer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\OakIdeas.Aspire.DataExplorer.Contracts\bin\$(Configuration)\$(TargetFramework)\OakIdeas.Aspire.DataExplorer.Contracts.dll" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false" />
    <None Include="..\OakIdeas.Aspire.DataExplorer.Core\bin\$(Configuration)\$(TargetFramework)\OakIdeas.Aspire.DataExplorer.Core.dll" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false" />
    <None Include="..\OakIdeas.Aspire.DataExplorer.Data\bin\$(Configuration)\$(TargetFramework)\OakIdeas.Aspire.DataExplorer.Data.dll" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false" />
  </ItemGroup>

</Project>

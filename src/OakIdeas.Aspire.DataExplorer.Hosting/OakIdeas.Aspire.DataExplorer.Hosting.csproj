<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>OakIdeas.Aspire.DataExplorer.Hosting</PackageId>
    <Title>OakIdeas Aspire Data Explorer Hosting</Title>
    <Description>Aspire hosting integration package for adding OakIdeas Data Explorer to development-time AppHost projects.</Description>
    <DataExplorerPublishedAppDir>$(MSBuildProjectDirectory)\DataExplorerWeb\publish\</DataExplorerPublishedAppDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.3.2" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Core\OakIdeas.Aspire.DataExplorer.Core.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Web\OakIdeas.Aspire.DataExplorer.Web.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\OakIdeas.Aspire.DataExplorer.Hosting.targets"
          Pack="true"
          PackagePath="buildTransitive\OakIdeas.Aspire.DataExplorer.Hosting.targets" />
  </ItemGroup>

  <Target Name="PublishDataExplorerWebApp"
      BeforeTargets="GetCopyToOutputDirectoryItems;GenerateNuspec">
    <RemoveDir Directories="$(DataExplorerPublishedAppDir)"
               Condition="Exists('$(DataExplorerPublishedAppDir)')" />
    <MakeDir Directories="$(DataExplorerPublishedAppDir)" />

    <MSBuild Projects="..\OakIdeas.Aspire.DataExplorer.Web\OakIdeas.Aspire.DataExplorer.Web.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;PublishTrimmed=false;PublishDir=$(DataExplorerPublishedAppDir);NpmBuildEnabled=false" />

    <ItemGroup>
      <Content Include="$(DataExplorerPublishedAppDir)**\*.*">
        <Pack>true</Pack>
        <PackagePath>buildTransitive\data-explorer-web\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>

@page "/tables/{connectionName}/{schema}/{tableName}"

<PageTitle>@TableName — Data Explorer</PageTitle>

<div class="de-table-page">
    <div class="de-main__header">
        <span class="de-table-page__icon" aria-hidden="true">
            <HeroIcon Kind="HeroIconKind.TableCells" Size="18" />
        </span>
        <span class="de-table-breadcrumb">
            <span class="de-table-breadcrumb__part">@ConnectionName</span>
            <span class="de-table-breadcrumb__sep" aria-hidden="true">
                <HeroIcon Kind="HeroIconKind.ChevronRight" Size="12" />
            </span>
            <span class="de-table-breadcrumb__part">@Schema</span>
            <span class="de-table-breadcrumb__sep" aria-hidden="true">
                <HeroIcon Kind="HeroIconKind.ChevronRight" Size="12" />
            </span>
            <strong class="de-table-breadcrumb__table">@TableName</strong>
        </span>
    </div>

    <div class="de-table-body">
        <ResultsTable Columns="@_columns"
                      Rows="@_rows"
                      IsLoading="false"
                      ErrorMessage="" />
    </div>
</div>

@code {
    [Parameter]
    public string ConnectionName { get; set; } = string.Empty;

    [Parameter]
    public string Schema { get; set; } = string.Empty;

    [Parameter]
    public string TableName { get; set; } = string.Empty;

    private IReadOnlyList<string> _columns = ["Id", "Title", "IsCompleted", "CreatedAt"];
    private IReadOnlyList<IReadOnlyList<string?>> _rows = [
        ["1", "Set up DataExplorer", "true", "2025-01-01T10:00:00Z"],
        ["2", "Explore schemas", "false", "2025-01-02T11:30:00Z"]
    ];
}


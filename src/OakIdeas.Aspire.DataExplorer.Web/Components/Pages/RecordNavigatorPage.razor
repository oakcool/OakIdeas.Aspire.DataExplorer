@page "/record-navigator"
@using OakIdeas.Aspire.DataExplorer.Contracts.Models
@using OakIdeas.Aspire.DataExplorer.Core.Abstractions
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@using OakIdeas.Aspire.DataExplorer.Web.Services
@implements IDisposable
@inject FeatureFlagStateService FeatureFlags
@inject IRelationshipNavigatorService NavigatorService

<PageTitle>Record Navigator — Data Explorer</PageTitle>

@if (!FeatureFlags.RelationshipAwareNavigatorEnabled)
{
    <div class="de-feature-unavailable">
        <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="32" Class="de-feature-unavailable__icon" />
        <h2 class="de-feature-unavailable__title">Record Navigator Unavailable</h2>
        <p class="de-feature-unavailable__message">The Relationship-Aware Data Navigator feature is disabled by configuration.</p>
    </div>
    return;
}

<div class="de-main-page flex h-full min-h-0 flex-col bg-slate-950">

    @* ── Header ────────────────────────────────────────────────────── *@
    <div class="de-main__header flex shrink-0 flex-wrap items-center gap-3 border-b border-slate-800 bg-slate-900/80 px-5 py-3">
        <h2 class="de-main__title flex min-w-0 items-center gap-2 text-sm font-semibold text-slate-100">
            <HeroIcon Kind="HeroIconKind.ArrowsRightLeft" Size="18" Class="de-main__title-icon" />
            <span>Record Navigator</span>
            <span class="rounded border border-violet-500/40 bg-violet-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-violet-300">preview</span>
        </h2>
        <div class="flex flex-1 flex-wrap items-center gap-2">
            <button type="button"
                    class="flex items-center gap-1 rounded border border-slate-700 bg-slate-900 px-2 py-1 text-xs text-slate-300 transition hover:border-sky-400 hover:text-slate-100"
                    @onclick="ResetAsync"
                    title="Reset navigator">
                <HeroIcon Kind="HeroIconKind.ArrowPath" Size="13" />
                Reset
            </button>
        </div>
    </div>

    @* ── Table selector ──────────────────────────────────────────────── *@
    <div class="flex shrink-0 flex-wrap items-end gap-3 border-b border-slate-800 bg-slate-900/60 px-5 py-3">
        <div class="flex flex-col gap-1">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Schema</label>
            <input class="rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 placeholder:text-slate-500 outline-none focus:border-sky-500"
                   type="text"
                   placeholder="dbo"
                   maxlength="128"
                   @bind="_schemaName"
                   @bind:event="oninput" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Table</label>
            <input class="rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 placeholder:text-slate-500 outline-none focus:border-sky-500"
                   type="text"
                   placeholder="TableName"
                   maxlength="128"
                   @bind="_tableName"
                   @bind:event="oninput" />
        </div>
        <button type="button"
                class="flex items-center gap-1 rounded border border-sky-600 bg-sky-600/20 px-3 py-1 text-xs font-semibold text-sky-300 transition hover:border-sky-400 hover:bg-sky-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                @onclick="LoadRelationshipsAsync"
                disabled="@(_isLoading || string.IsNullOrWhiteSpace(_schemaName) || string.IsNullOrWhiteSpace(_tableName))"
                title="Load relationships for the specified table">
            <HeroIcon Kind="HeroIconKind.ArrowsRightLeft" Size="13" />
            Load Relationships
        </button>
    </div>

    @* ── Body ───────────────────────────────────────────────────────── *@
    <div class="flex min-h-0 flex-1 flex-col overflow-auto px-5 py-4">

        @if (_isLoading)
        {
            <div class="flex items-center gap-2 text-xs text-slate-400">
                <span class="inline-block h-3 w-3 animate-spin rounded-full border-2 border-slate-600 border-t-sky-400"></span>
                Loading relationships…
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="flex items-center gap-2 rounded border border-rose-700/40 bg-rose-900/20 px-4 py-3 text-xs text-rose-300">
                <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="16" />
                <span>@_errorMessage</span>
            </div>
        }
        else if (_relationships is not null)
        {
            @if (_relationships.Count == 0)
            {
                <div class="text-xs text-slate-400">
                    No navigable relationships found for <strong class="text-slate-200">@_schemaName.@_tableName</strong>.
                </div>
            }
            else
            {
                <div class="mb-3 text-xs text-slate-400">
                    Showing <strong class="text-slate-200">@_relationships.Count</strong>
                    relationship(s) for <strong class="text-slate-200">[@_schemaName].[@_tableName]</strong>.
                </div>

                <div class="flex flex-col gap-3">
                    @foreach (var rel in _relationships)
                    {
                        <div class="rounded border @(rel.Kind == RelationshipKind.Parent ? "border-sky-700/40 bg-sky-900/10" : "border-emerald-700/40 bg-emerald-900/10") p-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider @(rel.Kind == RelationshipKind.Parent ? "border border-sky-500/40 bg-sky-500/10 text-sky-300" : "border border-emerald-500/40 bg-emerald-500/10 text-emerald-300")">
                                    @(rel.Kind == RelationshipKind.Parent ? "Parent" : "Child")
                                </span>
                                <span class="font-semibold text-slate-100 text-sm">
                                    [@rel.RelatedSchemaName].[@rel.RelatedTableName]
                                </span>
                                <span class="text-xs text-slate-500">via @rel.ConstraintName</span>
                                @if (!rel.IsEnforced)
                                {
                                    <span class="rounded border border-amber-500/40 bg-amber-500/10 px-1.5 py-0.5 text-[10px] text-amber-300">disabled</span>
                                }
                            </div>

                            <div class="mt-2 flex flex-wrap gap-2 text-xs text-slate-400">
                                @foreach (var mapping in rel.ColumnMappings)
                                {
                                    <span class="rounded bg-slate-800 px-2 py-0.5">
                                        <span class="text-slate-200">@mapping.SourceColumnName</span>
                                        <span class="text-slate-500"> → </span>
                                        <span class="text-slate-200">@mapping.RelatedColumnName</span>
                                    </span>
                                }
                            </div>

                            @* Key value inputs for navigation *@
                            <div class="mt-3 flex flex-wrap items-end gap-2">
                                @for (var i = 0; i < rel.ColumnMappings.Count; i++)
                                {
                                    var idx = i;
                                    var mapping = rel.ColumnMappings[idx];
                                    var currentRel = rel;
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">@mapping.SourceColumnName</label>
                                        <input class="rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 placeholder:text-slate-500 outline-none focus:border-sky-500"
                                               type="text"
                                               placeholder="value"
                                               maxlength="256"
                                               value="@GetKeyValue(rel, idx)"
                                               @onchange="e => SetKeyValue(currentRel, idx, e.Value?.ToString())" />
                                    </div>
                                }

                                <button type="button"
                                        class="flex items-center gap-1 rounded border border-slate-700 bg-slate-900 px-2 py-1 text-xs text-slate-300 transition hover:border-violet-400 hover:text-violet-300 disabled:cursor-not-allowed disabled:opacity-50"
                                        @onclick="() => ShowCountAsync(rel)"
                                        disabled="@(_navigatingConstraint == rel.ConstraintName)"
                                        title="Preview related record count">
                                    <HeroIcon Kind="HeroIconKind.Eye" Size="13" />
                                    Count
                                </button>

                                <button type="button"
                                        class="flex items-center gap-1 rounded border border-sky-600 bg-sky-600/20 px-2 py-1 text-xs text-sky-300 transition hover:border-sky-400 disabled:cursor-not-allowed disabled:opacity-50"
                                        @onclick="() => NavigateAsync(rel)"
                                        disabled="@(_navigatingConstraint == rel.ConstraintName)"
                                        title="Load related records">
                                    <HeroIcon Kind="HeroIconKind.ArrowsRightLeft" Size="13" />
                                    Navigate
                                </button>
                            </div>

                            @* Count preview *@
                            @if (_counts.TryGetValue(rel.ConstraintName, out var countResult))
                            {
                                <div class="mt-2 text-xs text-slate-400">
                                    Related records:
                                    <strong class="text-slate-200">@countResult.Count</strong>
                                    @if (countResult.IsTruncated)
                                    {
                                        <span class="ml-1 rounded border border-amber-500/40 bg-amber-500/10 px-1.5 py-0.5 text-[10px] text-amber-300">truncated</span>
                                    }
                                </div>
                            }

                            @* Navigation results *@
                            @if (_results.TryGetValue(rel.ConstraintName, out var navResult))
                            {
                                <div class="mt-3">
                                    @if (navResult.Rows.Count == 0)
                                    {
                                        <p class="text-xs text-slate-400">No related records found.</p>
                                    }
                                    else
                                    {
                                        <div class="overflow-auto rounded border border-slate-700">
                                            <table class="w-full text-left text-xs text-slate-300">
                                                <thead class="border-b border-slate-700 bg-slate-900">
                                                    <tr>
                                                        @foreach (var col in navResult.Rows[0].Keys)
                                                        {
                                                            <th class="px-3 py-2 font-semibold text-slate-400">@col</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in navResult.Rows)
                                                    {
                                                        <tr class="border-b border-slate-800 hover:bg-slate-800/40">
                                                            @foreach (var cell in row.Values)
                                                            {
                                                                <td class="px-3 py-1.5">@(cell?.ToString() ?? "NULL")</td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        @if (navResult.HasMore)
                                        {
                                            <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
                                                <span>Showing first @navResult.Rows.Count rows.</span>
                                                <span class="text-slate-500 font-mono text-[10px] break-all">@navResult.GeneratedSql</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mt-1 text-xs text-slate-500 font-mono text-[10px] break-all">@navResult.GeneratedSql</div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="flex flex-col items-center justify-center gap-3 py-16 text-center text-slate-500">
                <HeroIcon Kind="HeroIconKind.ArrowsRightLeft" Size="40" Class="opacity-30" />
                <p class="text-sm">Enter a schema and table name above to discover navigable relationships.</p>
            </div>
        }
    </div>
</div>

@code {
    private string _schemaName = "dbo";
    private string _tableName = string.Empty;
    private bool _isLoading;
    private string? _errorMessage;
    private IReadOnlyList<TableRelationship>? _relationships;
    private string? _navigatingConstraint;
    private readonly Dictionary<string, GetRelatedRecordCountResponse> _counts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, NavigateRelatedRecordsResponse> _results = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, Dictionary<int, string?>> _keyValues = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        FeatureFlags.FlagsChanged += OnFlagsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await FeatureFlags.EnsureLoadedAsync(CancellationToken.None);
    }

    public void Dispose()
    {
        FeatureFlags.FlagsChanged -= OnFlagsChanged;
    }

    private void OnFlagsChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadRelationshipsAsync()
    {
        if (string.IsNullOrWhiteSpace(_schemaName) || string.IsNullOrWhiteSpace(_tableName))
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        _relationships = null;
        _counts.Clear();
        _results.Clear();
        _keyValues.Clear();
        StateHasChanged();

        try
        {
            var response = await NavigatorService.DiscoverRelationshipsAsync(
                new DiscoverTableRelationshipsRequest(_schemaName, _tableName),
                CancellationToken.None);

            _relationships = response.Relationships;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load relationships: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowCountAsync(TableRelationship rel)
    {
        _navigatingConstraint = rel.ConstraintName;
        StateHasChanged();

        try
        {
            var keyValues = BuildKeyValues(rel);
            var result = await NavigatorService.GetRelatedRecordCountAsync(
                new GetRelatedRecordCountRequest(
                    rel.RelatedSchemaName,
                    rel.RelatedTableName,
                    rel.ConstraintName,
                    keyValues),
                CancellationToken.None);

            _counts[rel.ConstraintName] = result;
        }
        finally
        {
            _navigatingConstraint = null;
            StateHasChanged();
        }
    }

    private async Task NavigateAsync(TableRelationship rel)
    {
        _navigatingConstraint = rel.ConstraintName;
        StateHasChanged();

        try
        {
            var keyValues = BuildKeyValues(rel);
            var result = await NavigatorService.NavigateRelatedRecordsAsync(
                new NavigateRelatedRecordsRequest(
                    rel.RelatedSchemaName,
                    rel.RelatedTableName,
                    rel.ConstraintName,
                    keyValues),
                CancellationToken.None);

            _results[rel.ConstraintName] = result;
        }
        finally
        {
            _navigatingConstraint = null;
            StateHasChanged();
        }
    }

    private IReadOnlyList<RelationshipKeyValue> BuildKeyValues(TableRelationship rel)
    {
        if (!_keyValues.TryGetValue(rel.ConstraintName, out var vals))
        {
            return rel.ColumnMappings
                .Select(m => new RelationshipKeyValue(m.RelatedColumnName, null))
                .ToList();
        }

        return rel.ColumnMappings
            .Select((m, i) => new RelationshipKeyValue(
                m.RelatedColumnName,
                vals.TryGetValue(i, out var v) ? v : null))
            .ToList();
    }

    private string? GetKeyValue(TableRelationship rel, int index)
    {
        if (_keyValues.TryGetValue(rel.ConstraintName, out var vals)
            && vals.TryGetValue(index, out var val))
        {
            return val;
        }

        return null;
    }

    private void SetKeyValue(TableRelationship rel, int index, string? value)
    {
        if (!_keyValues.TryGetValue(rel.ConstraintName, out var vals))
        {
            vals = new Dictionary<int, string?>();
            _keyValues[rel.ConstraintName] = vals;
        }

        vals[index] = value;
    }

    private Task ResetAsync()
    {
        _tableName = string.Empty;
        _relationships = null;
        _errorMessage = null;
        _counts.Clear();
        _results.Clear();
        _keyValues.Clear();
        return Task.CompletedTask;
    }
}

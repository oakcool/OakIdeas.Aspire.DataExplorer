@page "/explorer"

<PageTitle>Explorer — Data Explorer</PageTitle>

<div class="de-explorer-page">
    <div class="de-main">
        <div class="de-main__header">
            <h2 class="de-main__title">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="18" Class="de-main__title-icon" />
                <span>Schema Explorer</span>
            </h2>
            <StatusBadge Text="Select a table" Variant="info" />
        </div>

        <div class="de-explorer-body">
            <div class="de-explorer-empty">
                <span class="de-explorer-empty__icon" aria-hidden="true">
                    <HeroIcon Kind="HeroIconKind.TableCells" Size="36" />
                </span>
                <p>Select a table in the Object Explorer to browse its schema.</p>
            </div>
        </div>
    </div>
</div>


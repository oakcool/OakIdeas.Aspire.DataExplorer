@page "/diagram"
@using OakIdeas.Aspire.DataExplorer.Contracts.Models
@using OakIdeas.Aspire.DataExplorer.Contracts.Models.Explorer
@using OakIdeas.Aspire.DataExplorer.Web.Abstractions
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Molecules
@using OakIdeas.Aspire.DataExplorer.Web.Services
@implements IDisposable
@inject IExplorerService ExplorerService
@inject FeatureFlagStateService FeatureFlags

<PageTitle>Database Diagram — Data Explorer</PageTitle>

@if (!FeatureFlags.DatabaseDiagramEnabled)
{
    <div class="de-feature-unavailable">
        <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="32" Class="de-feature-unavailable__icon" />
        <h2 class="de-feature-unavailable__title">Database Diagram Unavailable</h2>
        <p class="de-feature-unavailable__message">The Database Diagram feature has been disabled. Update your configuration to enable it.</p>
    </div>
    return;
}

<PageTitle>Database Diagram — Data Explorer</PageTitle>

<div class="de-diagram-page flex h-full min-h-0 flex-col bg-slate-950">

    <div class="de-main__header flex shrink-0 items-center gap-3 border-b border-slate-800 bg-slate-900/80 px-5 py-3">
        <h2 class="de-main__title flex min-w-0 items-center gap-2 text-sm font-semibold text-slate-100">
            <HeroIcon Kind="HeroIconKind.ShareNodes" Size="18" Class="de-main__title-icon" />
            <span>Database Diagram</span>
        </h2>
        @if (_databaseName is not null)
        {
            <StatusBadge Text="@_databaseName" Variant="info" />
        }
        else if (!_isLoading)
        {
            <StatusBadge Text="Select a database" Variant="info" />
        }
    </div>

    @if (_error is not null)
    {
        <div class="de-diagram-page__error-stack p-4 flex flex-col gap-3">
            <ErrorAlert Error="@_error" />
            <ErrorRecovery Error="@_error" />
            <DiagnosticInfo Error="@_error" />
        </div>
    }

    <div class="de-diagram-page__canvas min-h-0 flex-1 overflow-hidden">
        <DatabaseDiagram DiagramData="@_diagramModel"
                         IsLoading="@_isLoading"
                         Class="h-full"
                         OnRefresh="HandleRefreshAsync" />
    </div>
</div>

@code {
    private DiagramModel? _diagramModel;
    private bool _isLoading = true;
    private DataExplorerError? _error;
    private string? _databaseName;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await FeatureFlags.EnsureLoadedAsync(CancellationToken.None);
        await LoadDiagramAsync();
    }

    private async Task LoadDiagramAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        var cts = new CancellationTokenSource();
        _cts = cts;

        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var response = await ExplorerService.GetDiagramDataAsync(cts.Token);

            if (cts.IsCancellationRequested) return;

            _error = response.CollectionStatus == MetadataCollectionStatus.Failed
                ? response.Error
                : null;

            var aggregated = response.AggregatedMetadata;
            _databaseName = aggregated?.DatabaseName;

            _diagramModel = aggregated is null ? null : BuildDiagramModel(aggregated);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        finally
        {
            if (!cts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task HandleRefreshAsync()
    {
        await LoadDiagramAsync();
    }

    private static DiagramModel BuildDiagramModel(DatabaseMetadata metadata)
    {
        var pkColumns = BuildPrimaryKeyLookup(metadata);
        var fkColumns = BuildForeignKeyColumnLookup(metadata);

        var entities = new List<DiagramEntityNode>();

        // Tables.
        foreach (var table in metadata.Tables)
        {
            var fqn = table.FullyQualifiedName;
            var columns = BuildColumnItems(fqn, metadata, pkColumns, fkColumns);
            entities.Add(new DiagramEntityNode(
                Id: fqn,
                Name: table.ObjectName,
                Schema: table.SchemaName,
                EntityType: "Table",
                Columns: columns));
        }

        // Views.
        foreach (var view in metadata.Views)
        {
            var fqn = view.FullyQualifiedName;
            var columns = BuildColumnItems(fqn, metadata, pkColumns, fkColumns);
            entities.Add(new DiagramEntityNode(
                Id: fqn,
                Name: view.ObjectName,
                Schema: view.SchemaName,
                EntityType: "View",
                Columns: columns));
        }

        var entityIds = entities
            .Select(e => e.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // Relationships from foreign keys.
        var relationships = new List<DiagramRelationshipEdge>();
        int edgeIndex = 0;
        foreach (var fks in metadata.ForeignKeysByTable.Values)
        {
            foreach (var fk in fks)
            {
                var parentId = ResolveEntityId(fk.ParentSchemaName, fk.ParentTableName, entityIds);
                var referencedId = ResolveEntityId(fk.ReferencedSchemaName, fk.ReferencedTableName, entityIds);

                if (parentId is null || referencedId is null)
                {
                    continue;
                }

                relationships.Add(new DiagramRelationshipEdge(
                    Id: $"edge-{edgeIndex++}",
                    ConstraintName: fk.ConstraintName,
                    ParentEntityId: parentId,
                    ReferencedEntityId: referencedId,
                    ColumnMappings: fk.KeyColumns
                        .Select(kc => new DiagramColumnMapping(kc.ParentColumnName, kc.ReferencedColumnName))
                        .ToArray()));
            }
        }

        return new DiagramModel(entities, relationships);
    }

    private static IReadOnlyList<DiagramColumnItem> BuildColumnItems(
        string fqn,
        DatabaseMetadata metadata,
        IReadOnlyDictionary<string, HashSet<string>> pkColumns,
        IReadOnlyDictionary<string, HashSet<string>> fkColumns)
    {
        if (!metadata.ColumnsByObject.TryGetValue(fqn, out var cols) || cols.Count == 0)
        {
            return [];
        }

        var pk = pkColumns.TryGetValue(fqn, out var pkSet) ? pkSet : null;
        var fk = fkColumns.TryGetValue(fqn, out var fkSet) ? fkSet : null;

        return cols.Select(c => new DiagramColumnItem(
            Name: c.Name,
            DataType: FormatDataType(c),
            IsPrimaryKey: pk?.Contains(c.Name) ?? false,
            IsForeignKey: fk?.Contains(c.Name) ?? false,
            IsNullable: c.IsNullable,
            IsIdentity: c.IsIdentity)).ToArray();
    }

    private static IReadOnlyDictionary<string, HashSet<string>> BuildPrimaryKeyLookup(DatabaseMetadata metadata)
    {
        var result = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var (fqn, pks) in metadata.PrimaryKeysByTable)
        {
            var cols = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var pk in pks)
            {
                foreach (var col in pk.KeyColumns)
                {
                    cols.Add(col);
                }
            }
            result[fqn] = cols;
        }
        return result;
    }

    private static IReadOnlyDictionary<string, HashSet<string>> BuildForeignKeyColumnLookup(DatabaseMetadata metadata)
    {
        var entityIds = metadata.Tables
            .Select(table => table.FullyQualifiedName)
            .Concat(metadata.Views.Select(view => view.FullyQualifiedName))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var result = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var fks in metadata.ForeignKeysByTable.Values)
        {
            foreach (var fk in fks)
            {
                var parentFqn = ResolveEntityId(fk.ParentSchemaName, fk.ParentTableName, entityIds)
                    ?? BuildQualifiedName(fk.ParentSchemaName, fk.ParentTableName);

                if (!result.TryGetValue(parentFqn, out var cols))
                {
                    cols = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    result[parentFqn] = cols;
                }
                foreach (var kc in fk.KeyColumns)
                {
                    cols.Add(kc.ParentColumnName);
                }
            }
        }
        return result;
    }

    private static string? ResolveEntityId(string? schemaName, string? tableName, HashSet<string> entityIds)
    {
        foreach (var candidate in EnumerateEntityIdCandidates(schemaName, tableName))
        {
            if (entityIds.Contains(candidate))
            {
                return candidate;
            }
        }

        return null;
    }

    private static IEnumerable<string> EnumerateEntityIdCandidates(string? schemaName, string? tableName)
    {
        var normalizedTable = NormalizeIdentifier(tableName);
        if (string.IsNullOrWhiteSpace(normalizedTable))
        {
            yield break;
        }

        yield return normalizedTable;

        var parts = normalizedTable.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            yield return $"{parts[^2]}.{parts[^1]}";
        }
        else
        {
            var normalizedSchema = NormalizeIdentifier(schemaName);
            if (!string.IsNullOrWhiteSpace(normalizedSchema))
            {
                yield return $"{normalizedSchema}.{parts[0]}";
            }
        }
    }

    private static string BuildQualifiedName(string? schemaName, string? tableName)
    {
        var normalizedTable = NormalizeIdentifier(tableName);
        if (string.IsNullOrWhiteSpace(normalizedTable))
        {
            return string.Empty;
        }

        var parts = normalizedTable.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[^2]}.{parts[^1]}";
        }

        var normalizedSchema = NormalizeIdentifier(schemaName);
        return string.IsNullOrWhiteSpace(normalizedSchema)
            ? parts[0]
            : $"{normalizedSchema}.{parts[0]}";
    }

    private static string NormalizeIdentifier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Replace("[", string.Empty, StringComparison.Ordinal)
            .Replace("]", string.Empty, StringComparison.Ordinal)
            .Replace("\"", string.Empty, StringComparison.Ordinal)
            .Trim()
            .Trim('.');
    }

    private static string FormatDataType(ColumnMetadata col)
    {
        if (col.MaxLength.HasValue && col.MaxLength.Value > 0)
            return $"{col.DataType}({col.MaxLength.Value})";
        if (col.Precision.HasValue && col.Scale.HasValue)
            return $"{col.DataType}({col.Precision.Value},{col.Scale.Value})";
        return col.DataType;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

@page "/query/{connectionName?}"
@using OakIdeas.Aspire.DataExplorer.Contracts.Models
@using OakIdeas.Aspire.DataExplorer.Contracts.Models.Explorer
@using OakIdeas.Aspire.DataExplorer.Web.Abstractions
@using OakIdeas.Aspire.DataExplorer.Web.Services
@inject IExplorerService ExplorerService
@inject QueryNavigationState QueryNavigationState
@inject QuerySessionState QuerySessionState

<PageTitle>Query — Data Explorer</PageTitle>

<div class="de-query-page">
    <div class="de-query-banner">
        <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="14" />
        <span>Development-only query window. Never execute untrusted SQL.</span>
    </div>

    <div class="de-query-pane de-query-pane--editor">
        <div class="de-query-pane__label">
            <HeroIcon Kind="HeroIconKind.CodeBracket" Size="15" Class="de-query-pane__label-icon" />
            <span>SQL Editor</span>
        </div>
        <div class="de-query-status">
            @if (_running)
            {
                <span>Executing query…</span>
            }
            else if (!string.IsNullOrEmpty(_status))
            {
                <span>@_status</span>
            }

            @if (IsReadOnlyMode)
            {
                <span class="de-query-status__pill">Read-only mode</span>
                <button type="button" class="de-query-status__toggle" @onclick="ToggleWriteMode" title="Enable write operations for this session">
                    <HeroIcon Kind="HeroIconKind.Eye" Size="12" />
                    Enable writes
                </button>
            }
            else
            {
                <span class="de-query-status__pill de-query-status__pill--write">Write mode</span>
                <button type="button" class="de-query-status__toggle de-query-status__toggle--active" @onclick="ToggleWriteMode" title="Return to read-only mode for this session">
                    <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="12" />
                    Disable writes
                </button>
            }
        </div>
        <QueryPanel ConnectionName="@_activeConnectionName"
                    @bind-Sql="_sql"
                    IsExecuting="_running"
                    IncludeExecutionPlan="_includeExecutionPlan"
                    IncludeExecutionPlanChanged="HandleIncludeExecutionPlanChanged"
                    OnExecute="RunQuery"
                    OnCancel="CancelQuery"
                    Suggestions="_suggestions" />
    </div>

    <div class="de-query-divider" aria-hidden="true"></div>

    <div class="de-query-pane de-query-pane--results">
        <div class="de-query-pane__tabs">
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeResultTab == ResultTab.Results)"
                    class="de-query-tab @(_activeResultTab == ResultTab.Results ? "de-query-tab--active" : string.Empty)"
                    @onclick="() => _activeResultTab = ResultTab.Results">
                <HeroIcon Kind="HeroIconKind.TableCells" Size="13" />
                Results
            </button>
            @if (_includeExecutionPlan)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(_activeResultTab == ResultTab.ExecutionPlan)"
                        class="de-query-tab @(_activeResultTab == ResultTab.ExecutionPlan ? "de-query-tab--active" : string.Empty)"
                        @onclick="() => _activeResultTab = ResultTab.ExecutionPlan">
                    <HeroIcon Kind="HeroIconKind.RectangleGroup" Size="13" />
                    Execution Plan
                </button>
            }
        <button type="button"
                role="tab"
                aria-selected="@(_activeResultTab == ResultTab.Errors)"
                class="de-query-tab de-query-tab--errors @(_activeResultTab == ResultTab.Errors ? "de-query-tab--errors-active" : string.Empty)"
                @onclick="() => _activeResultTab = ResultTab.Errors">
            <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="13" />
            Errors
            @if (_queryError is not null)
            {
                <span class="de-query-tab__badge">!</span>
            }
        </button>
    </div>

        @if (_activeResultTab == ResultTab.Results)
        {
            <ResultsTable Columns="@_columns"
                          Rows="@_rows"
                          IsLoading="_running"
                          ElapsedMilliseconds="_lastDurationMs" />
        }
        else if (_activeResultTab == ResultTab.ExecutionPlan)
        {
            <ExecutionPlanViewer IsLoading="_running" ExecutionPlan="_executionPlan" OnRenderError="HandleExecutionPlanRenderErrorAsync" />
        }
        else
        {
            <div class="de-query-errors">
                @if (_queryError is null)
                {
                    <div class="de-query-errors__empty">
                        <HeroIcon Kind="HeroIconKind.CheckCircle" Size="16" />
                        <span>No errors — last query executed successfully.</span>
                    </div>
                }
                else
                {
                    <div class="de-query-errors__panel">
                        <div class="de-query-errors__summary">
                            <div class="de-query-errors__summary-title">
                                <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="16" />
                                <span>@_queryError.Message</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_queryError.RecoverySuggestion))
                            {
                                <p class="de-query-errors__summary-recovery">@_queryError.RecoverySuggestion</p>
                            }
                        </div>

                        <table class="de-query-errors__details">
                            <tbody>
                                <tr>
                                    <th>Category</th>
                                    <td>@_queryError.Category</td>
                                </tr>
                                <tr>
                                    <th>Operation</th>
                                    <td>@_queryError.Operation</td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(_queryError.Target))
                                {
                                    <tr>
                                        <th>Target</th>
                                        <td>@_queryError.Target</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrWhiteSpace(_queryError.DiagnosticCode))
                                {
                                    <tr>
                                        <th>Diagnostic Code</th>
                                        <td>@_queryError.DiagnosticCode</td>
                                    </tr>
                                }
                                <tr>
                                    <th>Timestamp</th>
                                    <td>@_queryError.Timestamp.ToLocalTime().ToString("u")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? ConnectionName { get; set; }

    private enum ResultTab { Results, Errors, ExecutionPlan }

    private string _sql = string.Empty;
    private bool _running;
    private DataExplorerError? _queryError;
    private ExecutionPlanResponse? _executionPlan;
    private bool _includeExecutionPlan;
    private ResultTab _activeResultTab = ResultTab.Results;
    private string _status = string.Empty;
    private double? _lastDurationMs;
    private IReadOnlyList<string> _columns = [];
    private IReadOnlyList<IReadOnlyList<string?>> _rows = [];
    private IReadOnlyList<string> _suggestions = [];
    private bool _isDestructiveConfirmationPending;
    private CancellationTokenSource? _queryCts;
    private string _activeConnectionName = string.Empty;

    private bool IsReadOnlyMode => !QuerySessionState.WriteEnabled;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(ConnectionName))
        {
            var selected = await ExplorerService.GetSelectedDatabaseAsync(CancellationToken.None);
            _activeConnectionName = selected.Selection?.DatabaseName ?? string.Empty;
        }
        else
        {
            _activeConnectionName = ConnectionName;
        }

        _suggestions = await BuildSuggestionsAsync(CancellationToken.None);
    }

    protected override async Task OnParametersSetAsync()
    {
        // In-process navigation (context-menu) carries SQL via QueryNavigationState.
        // External deep-link navigation via URL parameters is not supported to prevent
        // drive-by SQL pre-population from crafted links.
        var pendingSql = QueryNavigationState.ConsumePendingSql();

        if (string.IsNullOrWhiteSpace(pendingSql))
        {
            return;
        }

        var autoExecute = QueryNavigationState.ConsumeAutoExecute();

        _sql = pendingSql;

        if (autoExecute)
        {
            await RunQuery(_sql);
        }
    }

    private async Task RunQuery(string sql)
    {
        if (_running)
        {
            return;
        }

        if (IsReadOnlyMode && IsPotentiallyDestructiveSql(sql))
        {
            _queryError = new DataExplorerError(
                Category: ErrorCategory.PermissionDenied,
                Message: "Read-only mode is enabled. Run a SELECT query or enable write operations.",
                RecoverySuggestion: "Use the 'Enable writes' toggle in the status bar to run write operations for this session.",
                Operation: "execute-query",
                Target: null,
                Timestamp: DateTimeOffset.UtcNow,
                DiagnosticCode: "read-only-mode");
            _activeResultTab = ResultTab.Errors;
            return;
        }

        if (IsPotentiallyDestructiveSql(sql) && !_isDestructiveConfirmationPending)
        {
            _isDestructiveConfirmationPending = true;
            _status = "Potentially destructive statement detected. Run Execute again to confirm.";
            _queryError = null;
            return;
        }

        _isDestructiveConfirmationPending = false;
        _running = true;
        _queryError = null;
        _executionPlan = null;
        _status = string.Empty;
        _columns = [];
        _rows = [];
        _queryCts?.Dispose();
        _queryCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var response = await ExplorerService.ExecuteQueryAsync(sql, _includeExecutionPlan, readOnly: IsReadOnlyMode, _queryCts.Token);
            if (response.Error is not null)
            {
                _queryError = response.Error;
                _executionPlan = response.ExecutionPlan;
                _status = response.Error.RecoverySuggestion ?? "Query execution failed.";
                _activeResultTab = ResultTab.Errors;
                return;
            }

            _queryError = null;
            _executionPlan = response.ExecutionPlan;
            _activeResultTab = ResultTab.Results;

            _columns = response.Columns;
            _rows = response.Rows
                .Select(row => _columns.Select(column => ToDisplayValue(row.TryGetValue(column, out var value) ? value : null)).ToArray())
                .ToArray();
            _lastDurationMs = response.Duration.TotalMilliseconds;

            var affected = response.AffectedRowCount.HasValue
                ? $", affected {response.AffectedRowCount.Value} row(s)"
                : string.Empty;
            var truncated = response.IsTruncated ? ", truncated to max row limit" : string.Empty;
            _status = $"Query executed successfully{affected}{truncated}.";
        }
        catch (OperationCanceledException)
        {
            _status = "Query canceled.";
            _queryError = null;
        }
        finally
        {
            _running = false;
        }
    }

    private void ToggleWriteMode()
    {
        QuerySessionState.WriteEnabled = !QuerySessionState.WriteEnabled;
        _isDestructiveConfirmationPending = false;
        _status = string.Empty;
    }

    private void CancelQuery()
    {
        if (_running)
        {
            _queryCts?.Cancel();
        }
    }

    private Task HandleIncludeExecutionPlanChanged(bool includeExecutionPlan)
    {
        _includeExecutionPlan = includeExecutionPlan;
        if (!_includeExecutionPlan && _activeResultTab == ResultTab.ExecutionPlan)
        {
            _activeResultTab = ResultTab.Results;
        }

        return Task.CompletedTask;
    }

    private async Task<IReadOnlyList<string>> BuildSuggestionsAsync(CancellationToken cancellationToken)
    {
        var suggestions = new HashSet<string>(QueryPanel.SqlKeywords, StringComparer.OrdinalIgnoreCase);

        var metadataResponse = await ExplorerService.GetDatabaseMetadataAsync(cancellationToken);
        var metadata = metadataResponse.AggregatedMetadata;
        if (metadata is null)
        {
            return suggestions.OrderBy(value => value, StringComparer.OrdinalIgnoreCase).ToArray();
        }

        foreach (var table in metadata.Tables)
        {
            suggestions.Add($"{table.SchemaName}.{table.ObjectName}");
        }

        foreach (var view in metadata.Views)
        {
            suggestions.Add($"{view.SchemaName}.{view.ObjectName}");
        }

        foreach (var procedure in metadata.ProceduresBySchema)
        {
            foreach (var item in procedure.Value)
            {
                suggestions.Add($"{procedure.Key}.{item.ProcedureName}");
            }
        }

        foreach (var schemaFunctions in metadata.FunctionsBySchema)
        {
            foreach (var functionGroup in schemaFunctions.Value)
            {
                foreach (var item in functionGroup.Value)
                {
                    suggestions.Add($"{schemaFunctions.Key}.{item.FunctionName}");
                }
            }
        }

        foreach (var column in metadata.ColumnsByObject.SelectMany(pair => pair.Value))
        {
            suggestions.Add(column.Name);
        }

        return suggestions.OrderBy(value => value, StringComparer.OrdinalIgnoreCase).ToArray();
    }

    private static bool IsPotentiallyDestructiveSql(string sql)
    {
        if (string.IsNullOrWhiteSpace(sql))
        {
            return false;
        }

        var firstToken = sql.TrimStart().Split([' ', '\t', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return firstToken?.ToUpperInvariant() is
            "INSERT" or "UPDATE" or "DELETE" or "MERGE" or "TRUNCATE" or "DROP" or "ALTER" or "CREATE" or "EXEC" or "EXECUTE";
    }

    private static string? ToDisplayValue(object? value)
        => value switch
        {
            null => null,
            DateTime dateTime => dateTime.ToString("u"),
            DateTimeOffset dateTimeOffset => dateTimeOffset.ToString("u"),
            byte[] bytes => Convert.ToBase64String(bytes),
            _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture)
        };

    private async Task HandleExecutionPlanRenderErrorAsync(string details)
    {
        var detailText = string.IsNullOrWhiteSpace(details)
            ? "No additional details provided."
            : details.Trim();

        _queryError = new DataExplorerError(
            Category: ErrorCategory.UnknownError,
            Message: $"Execution plan rendering failed. {detailText}",
            RecoverySuggestion: "Review the error details and raw execution plan, then retry the query.",
            Operation: "render-execution-plan",
            Target: string.IsNullOrWhiteSpace(_activeConnectionName) ? null : _activeConnectionName,
            Timestamp: DateTimeOffset.UtcNow,
            DiagnosticCode: "execution-plan-render-error");
        _status = "Execution plan rendering failed. See Errors tab for details.";
        _activeResultTab = ResultTab.Errors;
        await InvokeAsync(StateHasChanged);
    }

}

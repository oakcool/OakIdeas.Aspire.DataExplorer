@page "/"

<PageTitle>Dashboard — Data Explorer</PageTitle>

<div class="de-dashboard flex h-full min-h-0 flex-col bg-slate-950">
    <div class="de-main flex min-h-0 flex-1 flex-col overflow-auto bg-slate-950">
        <div class="de-main__header flex shrink-0 items-center gap-3 border-b border-slate-800 bg-slate-900/80 px-5 py-3">
            <h2 class="de-main__title inline-flex items-center gap-2 text-sm font-semibold text-slate-100">
                <HeroIcon Kind="HeroIconKind.Home" Size="18" Class="de-main__title-icon" />
                <span>Dashboard</span>
            </h2>
            <StatusBadge Text="Ready" Variant="connected" />
        </div>

        <div class="de-main__body flex flex-1 flex-col gap-6 overflow-y-auto bg-slate-950 p-6">
            <section class="de-brand-hero grid gap-5 rounded-2xl border border-sky-500/25 bg-gradient-to-r from-slate-900/95 via-slate-950 to-sky-950/60 p-4 shadow-xl shadow-slate-950/40 md:grid-cols-[170px_minmax(0,1fr)] md:items-center">
                <div class="de-brand-hero__art flex min-h-[150px] items-center justify-center overflow-hidden rounded-xl border border-sky-500/25 bg-slate-900" aria-hidden="true">
                    <img class="h-full w-full object-cover" src="/images/logo.png" alt="" />
                </div>
                <div class="de-brand-hero__copy flex flex-col gap-2">
                    <div class="de-brand-hero__eyebrow inline-flex w-fit items-center rounded-full border border-sky-500/30 bg-sky-500/10 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-sky-300">Development-only workspace</div>
                    <h3 class="text-3xl font-semibold tracking-tight text-slate-100">Explore live data with a fast, focused shell.</h3>
                    <p class="max-w-3xl text-base leading-relaxed text-slate-300">Browse connections, inspect object folders, and run SQL from a single interface built for Aspire-backed local development.</p>
                </div>
            </section>

            <div class="de-info-grid grid grid-cols-1 gap-3 md:grid-cols-3">
                <div class="de-info-card flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-900/90 p-4">
                    <span class="de-info-card__icon inline-flex items-center text-sky-400" aria-hidden="true">
                        <HeroIcon Kind="HeroIconKind.ServerStack" Size="24" />
                    </span>
                    <div>
                        <div class="de-info-card__label mb-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Provider</div>
                        <div class="de-info-card__value text-xl font-semibold text-slate-100">SQL Server (MVP)</div>
                    </div>
                </div>
                <div class="de-info-card flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-900/90 p-4">
                    <span class="de-info-card__icon inline-flex items-center text-sky-400" aria-hidden="true">
                        <HeroIcon Kind="HeroIconKind.Link" Size="24" />
                    </span>
                    <div>
                        <div class="de-info-card__label mb-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Connections</div>
                        <div class="de-info-card__value text-xl font-semibold text-slate-100">1 discovered</div>
                    </div>
                </div>
                <div class="de-info-card flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-900/90 p-4">
                    <span class="de-info-card__icon inline-flex items-center text-sky-400" aria-hidden="true">
                        <HeroIcon Kind="HeroIconKind.CheckCircle" Size="24" />
                    </span>
                    <div>
                        <div class="de-info-card__label mb-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Status</div>
                        <div class="de-info-card__value text-xl font-semibold text-slate-100">Initial setup complete</div>
                    </div>
                </div>
            </div>

            <div class="de-tip flex items-start gap-3 rounded-xl border border-sky-500/25 bg-sky-500/10 p-4 text-sm leading-relaxed text-slate-300">
                <span class="de-tip__icon inline-flex items-center text-sky-300" aria-hidden="true">
                    <HeroIcon Kind="HeroIconKind.LightBulb" Size="20" />
                </span>
                <p>Use the <strong>Object Explorer</strong> panel to browse connections and database-level folders like Tables, Views, Programmability, and Security. Select an object to open it, or use <strong>Explorer</strong> and <strong>Query</strong> in the top bar.</p>
            </div>
        </div>
    </div>
</div>

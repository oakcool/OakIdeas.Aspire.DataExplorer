@inherits LayoutComponentBase
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Molecules

<div class="de-shell">
    <AlertBanner />

    <div class="de-header">
        <div class="de-header__brand">
            <span class="de-header__logo" aria-hidden="true">🗄</span>
            <span class="de-header__title">Data Explorer</span>
        </div>
        <nav class="de-header__nav">
            <NavLink class="de-nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="de-nav-link" href="explorer">Explorer</NavLink>
            <NavLink class="de-nav-link" href="query/sample">Query</NavLink>
        </nav>
        <div class="de-header__end">
            <span class="de-header__version">dev</span>
        </div>
    </div>

    <div class="de-workspace">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

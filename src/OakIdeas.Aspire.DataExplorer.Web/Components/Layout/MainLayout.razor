@inherits LayoutComponentBase
@implements IDisposable
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Molecules
@using OakIdeas.Aspire.DataExplorer.Web.Components.ContextMenu
@using OakIdeas.Aspire.DataExplorer.Contracts.Models
@using OakIdeas.Aspire.DataExplorer.Contracts.Models.Explorer
@using OakIdeas.Aspire.DataExplorer.Web.Abstractions
@using OakIdeas.Aspire.DataExplorer.Core.Models
@using Microsoft.AspNetCore.Components.Web
@using OakIdeas.Aspire.DataExplorer.Web.Services
@inject NavigationManager NavigationManager
@inject IExplorerService ExplorerService
@inject QueryNavigationState QueryNavigationState
@inject ExplorerNavigationState ExplorerNavigationState
@inject FeatureFlagStateService FeatureFlags

<div class="de-shell flex h-screen min-h-screen flex-col overflow-hidden bg-slate-950 text-slate-100">
    <AlertBanner />

    <div class="de-header flex h-12 items-center gap-4 border-b border-slate-800 bg-slate-900 px-4">
        <div class="de-header__brand flex items-center gap-2 pr-2">
            <span class="de-header__logo inline-flex h-7 w-7 items-center justify-center overflow-hidden rounded-lg border border-sky-400/40 bg-sky-500/10 shadow-sm shadow-sky-500/10" aria-hidden="true">
                <img class="de-header__logo-image h-full w-full object-cover" src="/images/logo.svg" alt="" />
            </span>
            <span class="de-header__title text-sm font-semibold tracking-tight text-slate-100">Data Explorer</span>
        </div>
        <nav class="de-header__nav flex min-w-0 flex-1 items-center justify-center gap-2">
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="" Match="NavLinkMatch.All" title="Dashboard">
                <HeroIcon Kind="HeroIconKind.Home" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Dashboard</span>
            </NavLink>
            @if (FeatureFlags.ObjectExplorerEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="explorer" title="Explorer">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Explorer</span>
            </NavLink>
            }
            @if (FeatureFlags.QueryEditorEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="query" title="Query">
                <HeroIcon Kind="HeroIconKind.CodeBracket" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Query</span>
            </NavLink>
            }
            @if (FeatureFlags.DatabaseDiagramEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="diagram" title="Database Diagram">
                <HeroIcon Kind="HeroIconKind.ShareNodes" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Diagram</span>
            </NavLink>
            }
            @if (FeatureFlags.SchemaMigrationsEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="schema-migrations" title="Schema and Migrations">
                <HeroIcon Kind="HeroIconKind.CircleStack" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Schema</span>
            </NavLink>
            }
            @if (FeatureFlags.RequestTraceEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="request-trace" title="Request Trace">
                <HeroIcon Kind="HeroIconKind.Bolt" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Traces</span>
            </NavLink>
            }
            @if (FeatureFlags.DataChangeTimelineEnabled)
            {
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="data-change-timeline" title="Data Change Timeline">
                <HeroIcon Kind="HeroIconKind.Clock" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Timeline</span>
            </NavLink>
            }
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="settings" title="Settings">
                <HeroIcon Kind="HeroIconKind.Cog6Tooth" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Settings</span>
            </NavLink>
        </nav>
        <div class="de-header__end flex items-center gap-2">
            <span class="de-header__version rounded border border-sky-500/40 bg-sky-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-sky-300">dev</span>
        </div>
    </div>

    <div class="de-workspace-shell flex h-[calc(100vh-3rem)] min-h-0 flex-1 overflow-hidden bg-slate-950"
         @onpointermove="HandleSidebarResize"
         @onpointerup="StopSidebarResize"
         @onpointercancel="StopSidebarResize"
         @onpointerleave="StopSidebarResize">
        <aside class="de-layout-sidebar flex h-full min-w-0 flex-col overflow-hidden border-r border-slate-800 bg-slate-900/80 @( _isExplorerMinimized ? "w-14" : string.Empty )"
               style="@(!_isExplorerMinimized ? $"width:{ExplorerWidthPx}" : null)">
            @if (!_isExplorerMinimized)
            {
                <div class="de-database-picker flex shrink-0 flex-col gap-1.5 border-b border-slate-800 bg-slate-900 p-3">
                    <label class="de-database-picker__label text-[11px] font-semibold uppercase tracking-widest text-slate-400" for="database-picker">Database</label>
                    <select id="database-picker"
                            class="de-database-picker__select rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-200 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:border-slate-800 disabled:text-slate-500"
                            value="@_selectedResourceId"
                            disabled="@(_isExplorerLoading || !_availableDatabases.Any())"
                            @onchange="HandleDatabaseSelectionChanged">
                        @if (!_availableDatabases.Any())
                        {
                            <option value="">No databases discovered</option>
                        }
                        else
                        {
                            @foreach (var resource in _availableDatabases)
                            {
                                var optionText = BuildDatabaseOptionLabel(resource);
                                <option value="@resource.ResourceId" disabled="@(!resource.IsAvailable)">@optionText</option>
                            }
                        }
                    </select>
                </div>
            }

            <ObjectExplorer IsLoading="@_isExplorerLoading"
                            ErrorMessage="@_explorerErrorMessage"
                            Error="@_explorerError"
                            Connections="@_connections"
                            SelectedObject="@_selectedObject"
                            OnConnectionSelect="HandleConnectionSelect"
                            IsMinimized="_isExplorerMinimized"
                            OnObjectSelect="HandleObjectSelect"
                            OnContextAction="HandleContextAction"
                            OnRefresh="HandleRefresh"
                            DataEditing="@(new DataEditingOptions(InsertEnabled: FeatureFlags.DataInsertEnabled, DeleteEnabled: FeatureFlags.DataDeleteEnabled))"
                            OnMinimizeToggle="HandleExplorerMinimizeToggle" />
        </aside>

        @if (!_isExplorerMinimized)
        {
            <div class="de-layout-resizer w-1.5 shrink-0 cursor-col-resize bg-slate-800/80 transition hover:bg-sky-500/80"
                 role="separator"
                 aria-label="Resize Object Explorer"
                 @onpointerdown="StartSidebarResize"
                 @onpointerdown:preventDefault="true"></div>
        }

        <div class="de-workspace min-h-0 flex-1 overflow-hidden bg-slate-950">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-hidden="true">
        <HeroIcon Kind="HeroIconKind.XMark" Size="16" />
    </span>
</div>

@code {
    private const int MinExplorerWidth = 240;
    private const int MaxExplorerWidth = 520;
    private int _explorerWidth = 300;
    private bool _isExplorerMinimized;
    private bool _isResizingSidebar;
    private bool _isExplorerLoading;
    private string? _explorerErrorMessage;
    private DataExplorerError? _explorerError;
    private ObjectExplorer.ObjectSelection? _selectedObject;
    private string? _selectedResourceId;
    private CancellationTokenSource? _explorerLoadCts;

    private readonly List<DiscoveredDatabaseResource> _availableDatabases = [];
    private readonly List<ObjectExplorer.ConnectionNode> _connections = [];

    private string ExplorerWidthPx => $"{_explorerWidth}px";

    protected override async Task OnInitializedAsync()
    {
        FeatureFlags.FlagsChanged += HandleFlagsChanged;
        await FeatureFlags.EnsureLoadedAsync(CancellationToken.None);
        await LoadObjectExplorerAsync(forceRefresh: false);
    }

    private async void HandleFlagsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleRefresh()
    {
        return LoadObjectExplorerAsync(forceRefresh: true);
    }

    private void HandleConnectionSelect(string _)
    {
    }

    private async Task HandleDatabaseSelectionChanged(ChangeEventArgs args)
    {
        var selectedResourceId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(selectedResourceId))
        {
            return;
        }

        var selectedResource = _availableDatabases.FirstOrDefault(resource =>
            string.Equals(resource.ResourceId, selectedResourceId, StringComparison.OrdinalIgnoreCase));
        if (selectedResource is null || !selectedResource.IsAvailable)
        {
            return;
        }

        if (string.Equals(_selectedResourceId, selectedResourceId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var selectionResponse = await ExplorerService.SelectDatabaseAsync(selectedResourceId, CancellationToken.None);
        if (!selectionResponse.Succeeded || selectionResponse.Selection is null)
        {
            _explorerError = selectionResponse.Error;
            _explorerErrorMessage = selectionResponse.ValidationErrors.FirstOrDefault()
                ?? "Unable to select the requested database resource.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _selectedObject = null;
        NavigationManager.NavigateTo("/explorer", replace: true);

        _selectedResourceId = selectionResponse.Selection.ResourceId;
        await LoadObjectExplorerAsync(forceRefresh: true);
    }

    private void HandleObjectSelect(ObjectExplorer.ObjectSelection selection)
    {
        _selectedObject = selection;

        var objectType = selection.ObjectKind switch
        {
            ObjectExplorer.ObjectKind.Table => "table",
            ObjectExplorer.ObjectKind.View => "view",
            ObjectExplorer.ObjectKind.Procedure => "procedure",
            ObjectExplorer.ObjectKind.Function => "function",
            ObjectExplorer.ObjectKind.Trigger => "trigger",
            _ => "table",
        };

        ExplorerNavigationState.SetSelection(new ExplorerObjectSelection(
            ObjectId: selection.ObjectId,
            ObjectType: objectType,
            ObjectName: selection.ObjectName,
            SchemaName: selection.SchemaName,
            ConnectionName: selection.ConnectionName,
            DatabaseName: selection.DatabaseName));

        NavigationManager.NavigateTo("/explorer");
    }

    private void HandleContextAction(ExplorerContextAction action)
    {
        if (action.ActionId == "view")
        {
            HandleObjectSelect(action.Source);
            return;
        }

        if (string.IsNullOrWhiteSpace(action.Sql))
        {
            return;
        }

        QueryNavigationState.SetPendingSql(action.Sql);
        if (action.AutoExecute)
        {
            QueryNavigationState.RequestAutoExecute();
        }

        NavigationManager.NavigateTo("/query");
    }

    private void HandleExplorerMinimizeToggle(bool minimized)
    {
        _isExplorerMinimized = minimized;
    }

    private async Task LoadObjectExplorerAsync(bool forceRefresh)
    {
        _explorerLoadCts?.Cancel();
        _explorerLoadCts?.Dispose();
        var loadCts = new CancellationTokenSource();
        _explorerLoadCts = loadCts;

        _isExplorerLoading = true;
        _explorerErrorMessage = null;
        _explorerError = null;

        try
        {
            var token = loadCts.Token;
            var available = await ExplorerService.GetAvailableDatabasesAsync(token);
            _availableDatabases.Clear();
            _availableDatabases.AddRange(available.Resources);

            if (available.Error is not null)
            {
                _explorerError = available.Error;
                _explorerErrorMessage = available.Error.Message;
                _connections.Clear();
                return;
            }

            var selected = await EnsureSelectedDatabaseAsync(available, token);
            if (selected is null)
            {
                _selectedResourceId = null;
                _connections.Clear();
                return;
            }

            _selectedResourceId = selected.ResourceId;

            if (forceRefresh)
            {
                var refreshResponse = await ExplorerService.RefreshDatabaseMetadataAsync(token);
                if (refreshResponse.Status is RefreshStatus.Failed && refreshResponse.Errors.Any())
                {
                    _explorerError = refreshResponse.Error;
                    _explorerErrorMessage = refreshResponse.Errors[0];
                    _connections.Clear();
                    return;
                }
            }

            var metadataResponse = await ExplorerService.GetDatabaseMetadataAsync(token);
            if (metadataResponse.Metadata is null && metadataResponse.AggregatedMetadata is null)
            {
                _explorerError = metadataResponse.Error;
                _explorerErrorMessage = metadataResponse.Error?.Message
                    ?? string.Join(" ", metadataResponse.Errors);
                _connections.Clear();
                return;
            }

            if (metadataResponse.CollectionStatus is MetadataCollectionStatus.Failed)
            {
                _explorerError = metadataResponse.Error;
                _explorerErrorMessage = metadataResponse.Error?.Message
                    ?? "Metadata discovery did not complete successfully. Refresh and try again.";
                _connections.Clear();
                return;
            }

            var metadata = ResolveMetadataForExplorer(metadataResponse);
            if ((!HasDiscoverableObjects(metadata)) && !forceRefresh)
            {
                var refreshResponse = await ExplorerService.RefreshDatabaseMetadataAsync(token);
                if (refreshResponse.Status is RefreshStatus.Failed && refreshResponse.Errors.Any())
                {
                    _explorerError = refreshResponse.Error;
                    _explorerErrorMessage = refreshResponse.Errors[0];
                    _connections.Clear();
                    return;
                }

                metadataResponse = await ExplorerService.GetDatabaseMetadataAsync(token);
                if (metadataResponse.Metadata is null && metadataResponse.AggregatedMetadata is null)
                {
                    _explorerError = metadataResponse.Error;
                    _explorerErrorMessage = metadataResponse.Error?.Message
                        ?? string.Join(" ", metadataResponse.Errors);
                    _connections.Clear();
                    return;
                }

                if (metadataResponse.CollectionStatus is MetadataCollectionStatus.Failed)
                {
                    _explorerError = metadataResponse.Error;
                    _explorerErrorMessage = metadataResponse.Error?.Message
                        ?? "Metadata discovery did not complete successfully. Refresh and try again.";
                    _connections.Clear();
                    return;
                }

                metadata = ResolveMetadataForExplorer(metadataResponse);
            }

            if (metadata is null)
            {
                _connections.Clear();
                return;
            }

            var connectionNode = BuildConnectionNode(selected, metadata, metadataResponse.AggregatedMetadata);
            _connections.Clear();
            _connections.Add(connectionNode);
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _explorerError = ex is DataExplorerOperationException dataExplorerException
                ? dataExplorerException.Error
                : null;
            _explorerErrorMessage = _explorerError?.Message ?? "Unable to load metadata for Object Explorer.";
            _connections.Clear();
        }
        finally
        {
            if (ReferenceEquals(_explorerLoadCts, loadCts))
            {
                _isExplorerLoading = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildDatabaseOptionLabel(DiscoveredDatabaseResource resource)
    {
        var status = resource.IsAvailable ? string.Empty : " (unavailable)";
        return $"{resource.DatabaseName} - {resource.ResourceName} [{resource.ProviderType}]{status}";
    }

    private void StartSidebarResize(PointerEventArgs _)
    {
        _isResizingSidebar = true;
    }

    private void HandleSidebarResize(PointerEventArgs args)
    {
        if (!_isResizingSidebar || _isExplorerMinimized)
        {
            return;
        }

        var desiredWidth = (int)Math.Round(args.ClientX);
        _explorerWidth = Math.Clamp(desiredWidth, MinExplorerWidth, MaxExplorerWidth);
    }

    private void StopSidebarResize(PointerEventArgs _)
    {
        _isResizingSidebar = false;
    }

    public void Dispose()
    {
        FeatureFlags.FlagsChanged -= HandleFlagsChanged;
        _explorerLoadCts?.Cancel();
        _explorerLoadCts?.Dispose();
    }

    private async Task<ExplorerDatabaseSelection?> EnsureSelectedDatabaseAsync(
        GetAvailableDatabasesResponse available,
        CancellationToken cancellationToken)
    {
        if (!available.Resources.Any())
        {
            return null;
        }

        var selectedResponse = await ExplorerService.GetSelectedDatabaseAsync(cancellationToken);
        if (selectedResponse.Selection is not null && selectedResponse.Selection.IsValid)
        {
            return selectedResponse.Selection;
        }

        var target = available.Resources.FirstOrDefault(resource => resource.IsAvailable) ?? available.Resources[0];
        var selectionResponse = await ExplorerService.SelectDatabaseAsync(target.ResourceId, cancellationToken);
        if (!selectionResponse.Succeeded || selectionResponse.Selection is null)
        {
            _explorerError = selectionResponse.Error;
            _explorerErrorMessage = selectionResponse.ValidationErrors.FirstOrDefault()
                ?? "Unable to select a database resource for metadata loading.";
            return null;
        }

        return selectionResponse.Selection;
    }

    private static ObjectExplorer.ConnectionNode BuildConnectionNode(
        ExplorerDatabaseSelection selected,
        DatabaseMetadataRoot metadata,
        DatabaseMetadata? aggregatedMetadata)
        => new(
            selected.ResourceName,
            [
                new ObjectExplorer.DatabaseNode(
                    selected.DatabaseName,
                    BuildExplorerNodes(metadata, selected, aggregatedMetadata))
            ]);

    private static DatabaseMetadataRoot? ResolveMetadataForExplorer(GetDatabaseMetadataResponse response)
    {
        if (HasDiscoverableObjects(response.Metadata))
        {
            return response.Metadata;
        }

        if (response.AggregatedMetadata is null)
        {
            return response.Metadata;
        }

        return BuildRootMetadata(response.AggregatedMetadata);
    }

    private static bool HasDiscoverableObjects(DatabaseMetadataRoot? metadata)
    {
        if (metadata is null)
        {
            return false;
        }

        return metadata.Objects.TryGetValue(DatabaseObjectType.Table, out var tables) && tables.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.View, out var views) && views.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Procedure, out var procedures) && procedures.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Function, out var functions) && functions.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Trigger, out var triggers) && triggers.Count > 0;
    }

    private static DatabaseMetadataRoot BuildRootMetadata(DatabaseMetadata aggregated)
    {
        var objects = new Dictionary<DatabaseObjectType, IReadOnlyDictionary<string, DatabaseObject>>();

        objects[DatabaseObjectType.Schema] = aggregated.Schemas.ToDictionary(
            schema => schema.ObjectName,
            schema => (DatabaseObject)schema,
            StringComparer.OrdinalIgnoreCase);

        objects[DatabaseObjectType.Table] = aggregated.Tables.ToDictionary(
            table => table.FullyQualifiedName,
            table => (DatabaseObject)table,
            StringComparer.OrdinalIgnoreCase);

        objects[DatabaseObjectType.View] = aggregated.Views.ToDictionary(
            view => view.FullyQualifiedName,
            view => (DatabaseObject)view,
            StringComparer.OrdinalIgnoreCase);

        var procedures = aggregated.ProceduresBySchema
            .SelectMany(group => group.Value)
            .Select(procedure => new ProcedureObject(
                objectId: procedure.ObjectId,
                schemaName: procedure.SchemaName,
                objectName: procedure.ProcedureName))
            .ToArray();
        objects[DatabaseObjectType.Procedure] = procedures.ToDictionary(
            procedure => procedure.FullyQualifiedName,
            procedure => (DatabaseObject)procedure,
            StringComparer.OrdinalIgnoreCase);

        var functions = aggregated.FunctionsBySchema
            .SelectMany(group => group.Value.Values)
            .SelectMany(list => list)
            .Select(function => new FunctionObject(
                objectId: function.ObjectId,
                schemaName: function.SchemaName,
                objectName: function.FunctionName))
            .ToArray();
        objects[DatabaseObjectType.Function] = functions.ToDictionary(
            function => function.FullyQualifiedName,
            function => (DatabaseObject)function,
            StringComparer.OrdinalIgnoreCase);

        var triggers = aggregated.Triggers
            .Select(trigger => new TriggerObject(
                objectId: trigger.ObjectId,
                schemaName: trigger.SchemaName,
                objectName: trigger.TriggerName))
            .ToArray();
        objects[DatabaseObjectType.Trigger] = triggers.ToDictionary(
            trigger => trigger.FullyQualifiedName,
            trigger => (DatabaseObject)trigger,
            StringComparer.OrdinalIgnoreCase);

        return new DatabaseMetadataRoot(
            databaseName: aggregated.DatabaseName,
            providerType: aggregated.ProviderType,
            resourceId: aggregated.ResourceId,
            metadataCollectionTime: aggregated.MetadataCollectionTime,
            objects: objects);
    }

    private static IReadOnlyList<ObjectExplorer.ExplorerNodeModel> BuildExplorerNodes(
        DatabaseMetadataRoot metadata,
        ExplorerDatabaseSelection selected,
        DatabaseMetadata? aggregatedMetadata)
    {
        List<ObjectExplorer.ExplorerNodeModel> nodes = [];

        AddFolderNode(
            nodes,
            key: "tables",
            label: "Tables",
            icon: HeroIconKind.TableCells,
            children: BuildObjectLeafNodes(metadata, selected, DatabaseObjectType.Table, ObjectExplorer.ObjectKind.Table, HeroIconKind.TableCells, aggregatedMetadata),
            includeWhenEmpty: true);

        AddFolderNode(
            nodes,
            key: "views",
            label: "Views",
            icon: HeroIconKind.QueueList,
            children: BuildObjectLeafNodes(metadata, selected, DatabaseObjectType.View, ObjectExplorer.ObjectKind.View, HeroIconKind.QueueList, aggregatedMetadata),
            includeWhenEmpty: true);

        List<ObjectExplorer.ExplorerNodeModel> programmabilityNodes = [];
        AddFolderNode(
            programmabilityNodes,
            key: "stored-procedures",
            label: "Stored Procedures",
            icon: HeroIconKind.Play,
            children: BuildObjectLeafNodes(metadata, selected, DatabaseObjectType.Procedure, ObjectExplorer.ObjectKind.Procedure, HeroIconKind.Play, aggregatedMetadata),
            includeWhenEmpty: true);
        AddFolderNode(
            programmabilityNodes,
            key: "functions",
            label: "Functions",
            icon: HeroIconKind.CodeBracket,
            children: BuildObjectLeafNodes(metadata, selected, DatabaseObjectType.Function, ObjectExplorer.ObjectKind.Function, HeroIconKind.CodeBracket, aggregatedMetadata),
            includeWhenEmpty: true);
        AddFolderNode(
            programmabilityNodes,
            key: "triggers",
            label: "Triggers",
            icon: HeroIconKind.Link,
            children: BuildObjectLeafNodes(metadata, selected, DatabaseObjectType.Trigger, ObjectExplorer.ObjectKind.Trigger, HeroIconKind.Link, aggregatedMetadata),
            includeWhenEmpty: true);

        AddFolderNode(
            nodes,
            key: "programmability",
            label: "Programmability",
            icon: HeroIconKind.Folder,
            children: programmabilityNodes,
            includeWhenEmpty: true);

        List<ObjectExplorer.ExplorerNodeModel> securityNodes = [];
        AddFolderNode(
            securityNodes,
            key: "schemas",
            label: "Schemas",
            icon: HeroIconKind.UserGroup,
            children: BuildSecurityLeafNodes(metadata, DatabaseObjectType.Schema),
            includeWhenEmpty: true);

        AddFolderNode(
            nodes,
            key: "security",
            label: "Security",
            icon: HeroIconKind.Folder,
            children: securityNodes,
            includeWhenEmpty: true);

        return nodes;
    }

    private static IReadOnlyList<ObjectExplorer.ExplorerNodeModel> BuildObjectLeafNodes(
        DatabaseMetadataRoot metadata,
        ExplorerDatabaseSelection selected,
        DatabaseObjectType objectType,
        ObjectExplorer.ObjectKind objectKind,
        HeroIconKind icon,
        DatabaseMetadata? aggregatedMetadata)
    {
        if (!metadata.Objects.TryGetValue(objectType, out var objectsByName) || objectsByName.Count == 0)
        {
            return [];
        }

        return objectsByName.Values
            .Select(databaseObject =>
            {
                var schemaName = ResolveSchemaName(databaseObject);
                return new ObjectExplorer.ExplorerNodeModel(
                    NodeKey: $"{objectType}:{databaseObject.ObjectId}",
                    Label: BuildObjectLabel(databaseObject, schemaName),
                    Icon: icon,
                    Children: BuildMetadataChildNodes(databaseObject, schemaName, objectKind, aggregatedMetadata),
                    Selection: new ObjectExplorer.ObjectSelection(
                        selected.ResourceName,
                        selected.DatabaseName,
                        schemaName,
                        databaseObject.ObjectId,
                        databaseObject.ObjectName,
                        objectKind));
            })
            .OrderBy(item => item.Label, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.NodeKey, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static IReadOnlyList<ObjectExplorer.ExplorerNodeModel> BuildMetadataChildNodes(
        DatabaseObject databaseObject,
        string schemaName,
        ObjectExplorer.ObjectKind objectKind,
        DatabaseMetadata? aggregatedMetadata)
    {
        if (aggregatedMetadata is null)
        {
            return [];
        }

        var fullyQualifiedName = $"{schemaName}.{databaseObject.ObjectName}";
        List<ObjectExplorer.ExplorerNodeModel> nodes = [];

        switch (objectKind)
        {
            case ObjectExplorer.ObjectKind.Table:
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:columns",
                    label: "Columns",
                    icon: HeroIconKind.TableCells,
                    children: TryGetMetadataItems(aggregatedMetadata.ColumnsByObject, databaseObject, schemaName, fullyQualifiedName, out var columns)
                        ? columns.Select(column => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:column:{column.Name}",
                            Label: $"{column.Name} ({FormatColumnDetails(column)})",
                            Icon: GetColumnIcon(column),
                            Children: []))
                        .ToArray()
                        : [],
                    includeWhenEmpty: true);
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:keys",
                    label: "Keys",
                    icon: HeroIconKind.Folder,
                    children: TryGetMetadataItems(aggregatedMetadata.PrimaryKeysByTable, databaseObject, schemaName, fullyQualifiedName, out var primaryKeys)
                        ? primaryKeys.Select(primaryKey => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:key:{primaryKey.ConstraintName}",
                            Label: $"{primaryKey.ConstraintName} ({(primaryKey.IsClustered ? "Clustered" : "Non-clustered")})",
                            Icon: HeroIconKind.Key,
                            Children: []))
                        .ToArray()
                        : [],
                    includeWhenEmpty: true);
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:constraints",
                    label: "Constraints",
                    icon: HeroIconKind.Folder,
                    children: aggregatedMetadata.Constraints
                        .Where(constraint =>
                            constraint.SchemaName.Equals(schemaName, StringComparison.OrdinalIgnoreCase)
                            && constraint.TableName.Equals(databaseObject.ObjectName, StringComparison.OrdinalIgnoreCase))
                        .Select(constraint => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:constraint:{constraint.ConstraintName}",
                            Label: $"{constraint.ConstraintName} ({FormatConstraintDetails(constraint)})",
                            Icon: HeroIconKind.CheckCircle,
                            Children: []))
                        .ToArray(),
                    includeWhenEmpty: true);
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:triggers",
                    label: "Triggers",
                    icon: HeroIconKind.Link,
                    children: aggregatedMetadata.Triggers
                        .Where(trigger =>
                            trigger.ParentObjectType == TriggerParentObjectType.Table
                            && trigger.ParentObjectName.Equals(databaseObject.ObjectName, StringComparison.OrdinalIgnoreCase)
                            && (string.IsNullOrWhiteSpace(trigger.ParentSchemaName)
                                || trigger.ParentSchemaName.Equals(schemaName, StringComparison.OrdinalIgnoreCase)))
                        .Select(trigger => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:trigger:{trigger.TriggerName}",
                            Label: $"{trigger.TriggerName} ({FormatTriggerDetails(trigger)})",
                            Icon: HeroIconKind.Link,
                            Children: []))
                        .ToArray(),
                    includeWhenEmpty: true);
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:indexes",
                    label: "Indexes",
                    icon: HeroIconKind.Folder,
                    children: TryGetMetadataItems(aggregatedMetadata.IndexesByTable, databaseObject, schemaName, fullyQualifiedName, out var indexes)
                        ? indexes.Select(index => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:index:{index.IndexName}",
                            Label: $"{index.IndexName} ({FormatIndexDetails(index)})",
                            Icon: index.IsPrimaryKey ? HeroIconKind.Key : HeroIconKind.QueueList,
                            Children: []))
                        .ToArray()
                        : [],
                    includeWhenEmpty: true);
                break;

            case ObjectExplorer.ObjectKind.View:
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:columns",
                    label: "Columns",
                    icon: HeroIconKind.TableCells,
                    children: TryGetMetadataItems(aggregatedMetadata.ColumnsByObject, databaseObject, schemaName, fullyQualifiedName, out var viewColumns)
                        ? viewColumns.Select(column => new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:column:{column.Name}",
                            Label: $"{column.Name} ({FormatColumnDetails(column)})",
                            Icon: GetColumnIcon(column),
                            Children: []))
                        .ToArray()
                        : [],
                    includeWhenEmpty: true);
                break;

            case ObjectExplorer.ObjectKind.Procedure:
                var procedure = aggregatedMetadata.ProceduresBySchema.TryGetValue(schemaName, out var procedures)
                    ? procedures.FirstOrDefault(item => item.ProcedureName.Equals(databaseObject.ObjectName, StringComparison.OrdinalIgnoreCase))
                    : null;
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:parameters",
                    label: "Parameters",
                    icon: HeroIconKind.Folder,
                    children: procedure?.Parameters?.Select(parameter => new ObjectExplorer.ExplorerNodeModel(
                        NodeKey: $"{databaseObject.ObjectId}:parameter:{parameter.Name}",
                        Label: $"{parameter.Name} ({FormatRoutineParameterDetails(parameter.DataType, parameter.Direction, parameter.HasDefault)})",
                        Icon: HeroIconKind.AtSymbol,
                        Children: []))
                    .ToArray() ?? [],
                    includeWhenEmpty: true);
                break;

            case ObjectExplorer.ObjectKind.Function:
                FunctionMetadata? function = null;
                if (aggregatedMetadata.FunctionsBySchema.TryGetValue(schemaName, out var byType))
                {
                    function = byType.Values
                        .SelectMany(list => list)
                        .FirstOrDefault(item => item.FunctionName.Equals(databaseObject.ObjectName, StringComparison.OrdinalIgnoreCase));
                }

                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:parameters",
                    label: "Parameters",
                    icon: HeroIconKind.Folder,
                    children: function?.Parameters?.Select(parameter => new ObjectExplorer.ExplorerNodeModel(
                        NodeKey: $"{databaseObject.ObjectId}:parameter:{parameter.Name}",
                        Label: $"{parameter.Name} ({parameter.DataType})",
                        Icon: HeroIconKind.AtSymbol,
                        Children: []))
                    .ToArray() ?? [],
                    includeWhenEmpty: true);
                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:return-type",
                    label: "Return Type",
                    icon: HeroIconKind.Folder,
                    children: string.IsNullOrWhiteSpace(function?.ReturnType)
                        ? []
                        : [new ObjectExplorer.ExplorerNodeModel(
                            NodeKey: $"{databaseObject.ObjectId}:return-type:value",
                            Label: $"Returns ({function!.ReturnType!})",
                            Icon: HeroIconKind.CodeBracket,
                            Children: [])],
                    includeWhenEmpty: true);
                break;

            case ObjectExplorer.ObjectKind.Trigger:
                var trigger = aggregatedMetadata.Triggers.FirstOrDefault(item =>
                    item.SchemaName.Equals(schemaName, StringComparison.OrdinalIgnoreCase)
                    && item.TriggerName.Equals(databaseObject.ObjectName, StringComparison.OrdinalIgnoreCase));

                AddFolderNode(
                    nodes,
                    key: $"{databaseObject.ObjectId}:properties",
                    label: "Properties",
                    icon: HeroIconKind.Folder,
                    children: trigger is null
                        ? []
                        :
                        [
                            new ObjectExplorer.ExplorerNodeModel(
                                NodeKey: $"{databaseObject.ObjectId}:trigger-type",
                                Label: $"Type ({trigger.TriggerType})",
                                Icon: HeroIconKind.Link,
                                Children: []),
                            new ObjectExplorer.ExplorerNodeModel(
                                NodeKey: $"{databaseObject.ObjectId}:trigger-enabled",
                                Label: $"Enabled ({(trigger.IsEnabled ? "Yes" : "No")})",
                                Icon: HeroIconKind.Link,
                                Children: []),
                        ],
                    includeWhenEmpty: true);
                break;
        }

        return nodes;
    }

    private static IReadOnlyList<ObjectExplorer.ExplorerNodeModel> BuildSecurityLeafNodes(
        DatabaseMetadataRoot metadata,
        DatabaseObjectType objectType)
    {
        if (!metadata.Objects.TryGetValue(objectType, out var objectsByName) || objectsByName.Count == 0)
        {
            return [];
        }

        return objectsByName.Values
            .Select(databaseObject => new ObjectExplorer.ExplorerNodeModel(
                NodeKey: $"{objectType}:{databaseObject.ObjectId}",
                Label: databaseObject.ObjectName,
                Icon: objectType == DatabaseObjectType.Schema ? HeroIconKind.UserGroup : HeroIconKind.Folder,
                Children: []))
            .OrderBy(item => item.Label, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.NodeKey, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static void AddFolderNode(
        ICollection<ObjectExplorer.ExplorerNodeModel> nodes,
        string key,
        string label,
        HeroIconKind icon,
        IReadOnlyList<ObjectExplorer.ExplorerNodeModel> children,
        bool includeWhenEmpty = false)
    {
        if (!includeWhenEmpty && children.Count == 0)
        {
            return;
        }

        nodes.Add(new ObjectExplorer.ExplorerNodeModel(
            NodeKey: key,
            Label: label,
            Icon: icon,
            Children: children));
    }

    private static bool TryGetMetadataItems<T>(
        IReadOnlyDictionary<string, IReadOnlyList<T>> itemsByObject,
        DatabaseObject databaseObject,
        string schemaName,
        string fullyQualifiedName,
        out IReadOnlyList<T> items)
    {
        if (itemsByObject.TryGetValue(fullyQualifiedName, out var requestedItems))
        {
            items = requestedItems ?? [];
            return true;
        }

        if (itemsByObject.TryGetValue(databaseObject.FullyQualifiedName, out var fallbackItems))
        {
            items = fallbackItems ?? [];
            return true;
        }

        var normalizedRequestedName = NormalizeQualifiedName($"{schemaName}.{databaseObject.ObjectName}");
        foreach (var pair in itemsByObject)
        {
            if (string.Equals(NormalizeQualifiedName(pair.Key), normalizedRequestedName, StringComparison.Ordinal))
            {
                items = pair.Value ?? [];
                return true;
            }
        }

        items = [];
        return false;
    }

    private static string NormalizeQualifiedName(string value)
    {
        var segments = value
            .Split('.', StringSplitOptions.RemoveEmptyEntries)
            .Select(segment => segment.Trim().Trim('[', ']', '"', '`'))
            .Where(segment => segment.Length > 0);
        return string.Join(".", segments).ToUpperInvariant();
    }

    private static string BuildObjectLabel(DatabaseObject databaseObject, string schemaName)
        => string.IsNullOrWhiteSpace(schemaName) || string.Equals(schemaName, "default", StringComparison.OrdinalIgnoreCase)
            ? databaseObject.ObjectName
            : $"{schemaName}.{databaseObject.ObjectName}";

    private static string FormatColumnType(OakIdeas.Aspire.DataExplorer.Contracts.Models.ColumnMetadata column)
    {
        if (column.MaxLength.HasValue && column.MaxLength.Value > 0)
        {
            return $"{column.DataType}({column.MaxLength.Value})";
        }

        if (column.Precision.HasValue && column.Scale.HasValue)
        {
            return $"{column.DataType}({column.Precision.Value},{column.Scale.Value})";
        }

        return column.DataType;
    }

    private static HeroIconKind GetColumnIcon(OakIdeas.Aspire.DataExplorer.Contracts.Models.ColumnMetadata column)
        => (column.IsIdentity, TryGetProviderFlag(column.ProviderMetadata, "isPrimaryKey"), TryGetProviderFlag(column.ProviderMetadata, "isForeignKey")) switch
        {
            (_, true, _) => HeroIconKind.Key,
            (_, _, true) => HeroIconKind.Link,
            (true, _, _) => HeroIconKind.Key,
            _ => HeroIconKind.ViewColumns,
        };

    private static string FormatColumnDetails(OakIdeas.Aspire.DataExplorer.Contracts.Models.ColumnMetadata column)
    {
        var details = new List<string>();
        if (TryGetProviderFlag(column.ProviderMetadata, "isPrimaryKey"))
        {
            details.Add("PK");
        }

        if (TryGetProviderFlag(column.ProviderMetadata, "isForeignKey"))
        {
            details.Add("FK");
        }

        if (column.IsIdentity)
        {
            details.Add("identity");
        }

        if (column.IsComputed)
        {
            details.Add("computed");
        }

        details.Add(FormatColumnType(column));
        details.Add(column.IsNullable ? "null" : "not null");

        if (!string.IsNullOrWhiteSpace(column.DefaultValue))
        {
            details.Add($"default {column.DefaultValue}");
        }

        return string.Join(", ", details);
    }

    private static string FormatIndexDetails(IndexMetadata index)
    {
        var details = new List<string>();
        if (index.IsUnique && !index.IsPrimaryKey)
        {
            details.Add("Unique");
        }

        details.Add(index.IsClustered ? "Clustered" : "Non-clustered");
        return string.Join(", ", details);
    }

    private static string FormatConstraintDetails(ConstraintMetadata constraint)
    {
        var details = new List<string> { constraint.ConstraintType.ToString() };
        if (!string.IsNullOrWhiteSpace(constraint.ColumnName))
        {
            details.Add($"on {constraint.ColumnName}");
        }

        if (!string.IsNullOrWhiteSpace(constraint.Definition))
        {
            details.Add(constraint.Definition);
        }

        return string.Join(", ", details);
    }

    private static string FormatTriggerDetails(TriggerMetadata trigger)
        => $"{trigger.TriggerType}, {(trigger.IsEnabled ? "Enabled" : "Disabled")}";

    private static string FormatRoutineParameterDetails(string dataType, RoutineParameterDirection direction, bool hasDefault)
        => $"{dataType}, {FormatParameterDirection(direction)}, {(hasDefault ? "Has default" : "No default")}";

    private static string FormatParameterDirection(RoutineParameterDirection direction)
        => direction switch
        {
            RoutineParameterDirection.Output => "Output",
            RoutineParameterDirection.InputOutput => "Input/Output",
            _ => "Input",
        };

    private static bool TryGetProviderFlag(IReadOnlyDictionary<string, object?> providerMetadata, string key)
    {
        if (!providerMetadata.TryGetValue(key, out var value) || value is null)
        {
            return false;
        }

        return value switch
        {
            bool boolValue => boolValue,
            string text when bool.TryParse(text, out var parsed) => parsed,
            sbyte number => number != 0,
            byte number => number != 0,
            short number => number != 0,
            ushort number => number != 0,
            int number => number != 0,
            uint number => number != 0,
            long number => number != 0,
            ulong number => number != 0,
            _ => false,
        };
    }

    private static string ResolveSchemaName(DatabaseObject databaseObject)
    {
        if (databaseObject is SchemaBoundDatabaseObject schemaBoundObject)
        {
            return schemaBoundObject.SchemaName;
        }

        if (databaseObject is SchemaObject schemaObject)
        {
            return schemaObject.ObjectName;
        }

        var dotIndex = databaseObject.FullyQualifiedName.IndexOf('.', StringComparison.Ordinal);
        return dotIndex > 0
            ? databaseObject.FullyQualifiedName[..dotIndex]
            : "default";
    }

}

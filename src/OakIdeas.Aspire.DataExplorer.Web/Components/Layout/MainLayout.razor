@inherits LayoutComponentBase
@implements IDisposable
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Molecules
@using OakIdeas.Aspire.DataExplorer.Contracts.Models
@using OakIdeas.Aspire.DataExplorer.Contracts.Models.Explorer
@using OakIdeas.Aspire.DataExplorer.Web.Abstractions
@using OakIdeas.Aspire.DataExplorer.Core.Models
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager
@inject IExplorerService ExplorerService

<div class="de-shell flex h-screen min-h-screen flex-col overflow-hidden bg-slate-950 text-slate-100">
    <AlertBanner />

    <div class="de-header flex h-12 items-center gap-4 border-b border-slate-800 bg-slate-900 px-4">
        <div class="de-header__brand flex items-center gap-2 pr-2">
            <span class="de-header__logo inline-flex h-7 w-7 items-center justify-center overflow-hidden rounded-lg border border-sky-400/40 bg-sky-500/10 shadow-sm shadow-sky-500/10" aria-hidden="true">
                <img class="de-header__logo-image h-full w-full object-cover" src="/images/logo.svg" alt="" />
            </span>
            <span class="de-header__title text-sm font-semibold tracking-tight text-slate-100">Data Explorer</span>
        </div>
        <nav class="de-header__nav flex min-w-0 flex-1 items-center justify-center gap-2">
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="" Match="NavLinkMatch.All" title="Dashboard">
                <HeroIcon Kind="HeroIconKind.Home" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Dashboard</span>
            </NavLink>
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="explorer" title="Explorer">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Explorer</span>
            </NavLink>
            <NavLink class="de-nav-link inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-sky-400 hover:bg-slate-800/80 hover:text-slate-100 [&.active]:border-sky-400 [&.active]:bg-sky-500/20 [&.active]:text-sky-200" href="query" title="Query">
                <HeroIcon Kind="HeroIconKind.CodeBracket" Size="18" Class="de-nav-link__icon" />
                <span class="de-nav-link__label hidden md:inline">Query</span>
            </NavLink>
        </nav>
        <div class="de-header__end flex items-center gap-2">
            <span class="de-header__version rounded border border-sky-500/40 bg-sky-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-sky-300">dev</span>
        </div>
    </div>

    <div class="de-workspace-shell flex h-[calc(100vh-3rem)] min-h-0 flex-1 overflow-hidden bg-slate-950"
         @onpointermove="HandleSidebarResize"
         @onpointerup="StopSidebarResize"
         @onpointercancel="StopSidebarResize"
         @onpointerleave="StopSidebarResize">
        <aside class="de-layout-sidebar flex h-full min-w-0 flex-col overflow-hidden border-r border-slate-800 bg-slate-900/80 @( _isExplorerMinimized ? "w-14" : string.Empty )"
               style="@(!_isExplorerMinimized ? $"width:{ExplorerWidthPx}" : null)">
            @if (!_isExplorerMinimized)
            {
                <div class="de-database-picker flex shrink-0 flex-col gap-1.5 border-b border-slate-800 bg-slate-900 p-3">
                    <label class="de-database-picker__label text-[11px] font-semibold uppercase tracking-widest text-slate-400" for="database-picker">Database</label>
                    <select id="database-picker"
                            class="de-database-picker__select rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-200 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/30 disabled:cursor-not-allowed disabled:border-slate-800 disabled:text-slate-500"
                            value="@_selectedResourceId"
                            disabled="@(_isExplorerLoading || !_availableDatabases.Any())"
                            @onchange="HandleDatabaseSelectionChanged">
                        @if (!_availableDatabases.Any())
                        {
                            <option value="">No databases discovered</option>
                        }
                        else
                        {
                            @foreach (var resource in _availableDatabases)
                            {
                                var optionText = BuildDatabaseOptionLabel(resource);
                                <option value="@resource.ResourceId" disabled="@(!resource.IsAvailable)">@optionText</option>
                            }
                        }
                    </select>
                </div>
            }

            <ObjectExplorer IsLoading="@_isExplorerLoading"
                            ErrorMessage="@_explorerErrorMessage"
                            Error="@_explorerError"
                            Connections="@_connections"
                            SelectedObject="@_selectedObject"
                            OnConnectionSelect="HandleConnectionSelect"
                            IsMinimized="_isExplorerMinimized"
                            OnObjectSelect="HandleObjectSelect"
                            OnRefresh="HandleRefresh"
                            OnMinimizeToggle="HandleExplorerMinimizeToggle" />
        </aside>

        @if (!_isExplorerMinimized)
        {
            <div class="de-layout-resizer w-1.5 shrink-0 cursor-col-resize bg-slate-800/80 transition hover:bg-sky-500/80"
                 role="separator"
                 aria-label="Resize Object Explorer"
                 @onpointerdown="StartSidebarResize"
                 @onpointerdown:preventDefault="true"></div>
        }

        <div class="de-workspace min-h-0 flex-1 overflow-hidden bg-slate-950">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-hidden="true">
        <HeroIcon Kind="HeroIconKind.XMark" Size="16" />
    </span>
</div>

@code {
    private const int MinExplorerWidth = 240;
    private const int MaxExplorerWidth = 520;
    private int _explorerWidth = 300;
    private bool _isExplorerMinimized;
    private bool _isResizingSidebar;
    private bool _isExplorerLoading;
    private string? _explorerErrorMessage;
    private DataExplorerError? _explorerError;
    private ObjectExplorer.ObjectSelection? _selectedObject;
    private string? _selectedResourceId;
    private CancellationTokenSource? _explorerLoadCts;

    private readonly List<DiscoveredDatabaseResource> _availableDatabases = [];
    private readonly List<ObjectExplorer.ConnectionNode> _connections = [];

    private string ExplorerWidthPx => $"{_explorerWidth}px";

    protected override async Task OnInitializedAsync()
    {
        await LoadObjectExplorerAsync(forceRefresh: false);
    }

    private Task HandleRefresh()
    {
        return LoadObjectExplorerAsync(forceRefresh: true);
    }

    private void HandleConnectionSelect(string _)
    {
    }

    private async Task HandleDatabaseSelectionChanged(ChangeEventArgs args)
    {
        var selectedResourceId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(selectedResourceId))
        {
            return;
        }

        var selectedResource = _availableDatabases.FirstOrDefault(resource =>
            string.Equals(resource.ResourceId, selectedResourceId, StringComparison.OrdinalIgnoreCase));
        if (selectedResource is null || !selectedResource.IsAvailable)
        {
            return;
        }

        if (string.Equals(_selectedResourceId, selectedResourceId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var selectionResponse = await ExplorerService.SelectDatabaseAsync(selectedResourceId, CancellationToken.None);
        if (!selectionResponse.Succeeded || selectionResponse.Selection is null)
        {
            _explorerError = selectionResponse.Error;
            _explorerErrorMessage = selectionResponse.ValidationErrors.FirstOrDefault()
                ?? "Unable to select the requested database resource.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _selectedObject = null;
        NavigationManager.NavigateTo("/explorer", replace: true);

        _selectedResourceId = selectionResponse.Selection.ResourceId;
        await LoadObjectExplorerAsync(forceRefresh: true);
    }

    private void HandleObjectSelect(ObjectExplorer.ObjectSelection selection)
    {
        _selectedObject = selection;

        var objectType = selection.ObjectKind switch
        {
            ObjectExplorer.ObjectKind.Table => "table",
            ObjectExplorer.ObjectKind.View => "view",
            ObjectExplorer.ObjectKind.Procedure => "procedure",
            ObjectExplorer.ObjectKind.Function => "function",
            ObjectExplorer.ObjectKind.Trigger => "trigger",
            _ => "table",
        };

        var query = $"objectId={Uri.EscapeDataString(selection.ObjectId)}" +
                    $"&objectType={Uri.EscapeDataString(objectType)}" +
                    $"&objectName={Uri.EscapeDataString(selection.ObjectName)}" +
                    $"&schemaName={Uri.EscapeDataString(selection.SchemaName)}" +
                    $"&connectionName={Uri.EscapeDataString(selection.ConnectionName)}" +
                    $"&databaseName={Uri.EscapeDataString(selection.DatabaseName)}";

        NavigationManager.NavigateTo($"/explorer?{query}");
    }

    private void HandleExplorerMinimizeToggle(bool minimized)
    {
        _isExplorerMinimized = minimized;
    }

    private async Task LoadObjectExplorerAsync(bool forceRefresh)
    {
        _explorerLoadCts?.Cancel();
        _explorerLoadCts?.Dispose();
        var loadCts = new CancellationTokenSource();
        _explorerLoadCts = loadCts;

        _isExplorerLoading = true;
        _explorerErrorMessage = null;
        _explorerError = null;

        try
        {
            var token = loadCts.Token;
            var available = await ExplorerService.GetAvailableDatabasesAsync(token);
            _availableDatabases.Clear();
            _availableDatabases.AddRange(available.Resources);

            if (available.Error is not null)
            {
                _explorerError = available.Error;
                _explorerErrorMessage = available.Error.Message;
                _connections.Clear();
                return;
            }

            var selected = await EnsureSelectedDatabaseAsync(available, token);
            if (selected is null)
            {
                _selectedResourceId = null;
                _connections.Clear();
                return;
            }

            _selectedResourceId = selected.ResourceId;

            if (forceRefresh)
            {
                var refreshResponse = await ExplorerService.RefreshDatabaseMetadataAsync(token);
                if (refreshResponse.Status is RefreshStatus.Failed && refreshResponse.Errors.Any())
                {
                    _explorerError = refreshResponse.Error;
                    _explorerErrorMessage = refreshResponse.Errors[0];
                    _connections.Clear();
                    return;
                }
            }

            var metadataResponse = await ExplorerService.GetDatabaseMetadataAsync(token);
            if (metadataResponse.Errors.Any())
            {
                _explorerError = metadataResponse.Error;
                _explorerErrorMessage = string.Join(" ", metadataResponse.Errors);
                _connections.Clear();
                return;
            }

            if (metadataResponse.CollectionStatus is MetadataCollectionStatus.Failed)
            {
                _explorerError = metadataResponse.Error;
                _explorerErrorMessage = metadataResponse.Error?.Message
                    ?? "Metadata discovery did not complete successfully. Refresh and try again.";
                _connections.Clear();
                return;
            }

            var metadata = ResolveMetadataForExplorer(metadataResponse);
            if ((!HasDiscoverableObjects(metadata)) && !forceRefresh)
            {
                var refreshResponse = await ExplorerService.RefreshDatabaseMetadataAsync(token);
                if (refreshResponse.Status is RefreshStatus.Failed && refreshResponse.Errors.Any())
                {
                    _explorerError = refreshResponse.Error;
                    _explorerErrorMessage = refreshResponse.Errors[0];
                    _connections.Clear();
                    return;
                }

                metadataResponse = await ExplorerService.GetDatabaseMetadataAsync(token);
                if (metadataResponse.Errors.Any())
                {
                    _explorerError = metadataResponse.Error;
                    _explorerErrorMessage = string.Join(" ", metadataResponse.Errors);
                    _connections.Clear();
                    return;
                }

                if (metadataResponse.CollectionStatus is MetadataCollectionStatus.Failed)
                {
                    _explorerError = metadataResponse.Error;
                    _explorerErrorMessage = metadataResponse.Error?.Message
                        ?? "Metadata discovery did not complete successfully. Refresh and try again.";
                    _connections.Clear();
                    return;
                }

                metadata = ResolveMetadataForExplorer(metadataResponse);
            }

            if (metadata is null)
            {
                _connections.Clear();
                return;
            }

            var connectionNode = BuildConnectionNode(selected, metadata);
            _connections.Clear();
            _connections.Add(connectionNode);
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _explorerError = ex is DataExplorerOperationException dataExplorerException
                ? dataExplorerException.Error
                : null;
            _explorerErrorMessage = _explorerError?.Message ?? "Unable to load metadata for Object Explorer.";
            _connections.Clear();
        }
        finally
        {
            if (ReferenceEquals(_explorerLoadCts, loadCts))
            {
                _isExplorerLoading = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildDatabaseOptionLabel(DiscoveredDatabaseResource resource)
    {
        var status = resource.IsAvailable ? string.Empty : " (unavailable)";
        return $"{resource.DatabaseName} - {resource.ResourceName} [{resource.ProviderType}]{status}";
    }

    private void StartSidebarResize(PointerEventArgs _)
    {
        _isResizingSidebar = true;
    }

    private void HandleSidebarResize(PointerEventArgs args)
    {
        if (!_isResizingSidebar || _isExplorerMinimized)
        {
            return;
        }

        var desiredWidth = (int)Math.Round(args.ClientX);
        _explorerWidth = Math.Clamp(desiredWidth, MinExplorerWidth, MaxExplorerWidth);
    }

    private void StopSidebarResize(PointerEventArgs _)
    {
        _isResizingSidebar = false;
    }

    public void Dispose()
    {
        _explorerLoadCts?.Cancel();
        _explorerLoadCts?.Dispose();
    }

    private async Task<ExplorerDatabaseSelection?> EnsureSelectedDatabaseAsync(
        GetAvailableDatabasesResponse available,
        CancellationToken cancellationToken)
    {
        if (!available.Resources.Any())
        {
            return null;
        }

        var selectedResponse = await ExplorerService.GetSelectedDatabaseAsync(cancellationToken);
        if (selectedResponse.Selection is not null && selectedResponse.Selection.IsValid)
        {
            return selectedResponse.Selection;
        }

        var target = available.Resources.FirstOrDefault(resource => resource.IsAvailable) ?? available.Resources[0];
        var selectionResponse = await ExplorerService.SelectDatabaseAsync(target.ResourceId, cancellationToken);
        if (!selectionResponse.Succeeded || selectionResponse.Selection is null)
        {
            _explorerError = selectionResponse.Error;
            _explorerErrorMessage = selectionResponse.ValidationErrors.FirstOrDefault()
                ?? "Unable to select a database resource for metadata loading.";
            return null;
        }

        return selectionResponse.Selection;
    }

    private static ObjectExplorer.ConnectionNode BuildConnectionNode(
        ExplorerDatabaseSelection selected,
        DatabaseMetadataRoot metadata)
        => new(
            selected.ResourceName,
            [
                new ObjectExplorer.DatabaseNode(
                    selected.DatabaseName,
                    BuildSchemaNodes(metadata))
            ]);

    private static DatabaseMetadataRoot? ResolveMetadataForExplorer(GetDatabaseMetadataResponse response)
    {
        if (HasDiscoverableObjects(response.Metadata))
        {
            return response.Metadata;
        }

        if (response.AggregatedMetadata is null)
        {
            return response.Metadata;
        }

        return BuildRootMetadata(response.AggregatedMetadata);
    }

    private static bool HasDiscoverableObjects(DatabaseMetadataRoot? metadata)
    {
        if (metadata is null)
        {
            return false;
        }

        return metadata.Objects.TryGetValue(DatabaseObjectType.Table, out var tables) && tables.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.View, out var views) && views.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Procedure, out var procedures) && procedures.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Function, out var functions) && functions.Count > 0
            || metadata.Objects.TryGetValue(DatabaseObjectType.Trigger, out var triggers) && triggers.Count > 0;
    }

    private static DatabaseMetadataRoot BuildRootMetadata(DatabaseMetadata aggregated)
    {
        var objects = new Dictionary<DatabaseObjectType, IReadOnlyDictionary<string, DatabaseObject>>();

        objects[DatabaseObjectType.Schema] = aggregated.Schemas.ToDictionary(
            schema => schema.ObjectName,
            schema => (DatabaseObject)schema,
            StringComparer.OrdinalIgnoreCase);

        objects[DatabaseObjectType.Table] = aggregated.Tables.ToDictionary(
            table => table.FullyQualifiedName,
            table => (DatabaseObject)table,
            StringComparer.OrdinalIgnoreCase);

        objects[DatabaseObjectType.View] = aggregated.Views.ToDictionary(
            view => view.FullyQualifiedName,
            view => (DatabaseObject)view,
            StringComparer.OrdinalIgnoreCase);

        var procedures = aggregated.ProceduresBySchema
            .SelectMany(group => group.Value)
            .Select(procedure => new ProcedureObject(
                objectId: procedure.ObjectId,
                schemaName: procedure.SchemaName,
                objectName: procedure.ProcedureName))
            .ToArray();
        objects[DatabaseObjectType.Procedure] = procedures.ToDictionary(
            procedure => procedure.FullyQualifiedName,
            procedure => (DatabaseObject)procedure,
            StringComparer.OrdinalIgnoreCase);

        var functions = aggregated.FunctionsBySchema
            .SelectMany(group => group.Value.Values)
            .SelectMany(list => list)
            .Select(function => new FunctionObject(
                objectId: function.ObjectId,
                schemaName: function.SchemaName,
                objectName: function.FunctionName))
            .ToArray();
        objects[DatabaseObjectType.Function] = functions.ToDictionary(
            function => function.FullyQualifiedName,
            function => (DatabaseObject)function,
            StringComparer.OrdinalIgnoreCase);

        var triggers = aggregated.Triggers
            .Select(trigger => new TriggerObject(
                objectId: trigger.ObjectId,
                schemaName: trigger.SchemaName,
                objectName: trigger.TriggerName))
            .ToArray();
        objects[DatabaseObjectType.Trigger] = triggers.ToDictionary(
            trigger => trigger.FullyQualifiedName,
            trigger => (DatabaseObject)trigger,
            StringComparer.OrdinalIgnoreCase);

        return new DatabaseMetadataRoot(
            databaseName: aggregated.DatabaseName,
            providerType: aggregated.ProviderType,
            resourceId: aggregated.ResourceId,
            metadataCollectionTime: aggregated.MetadataCollectionTime,
            objects: objects);
    }

    private static IReadOnlyList<ObjectExplorer.SchemaNode> BuildSchemaNodes(DatabaseMetadataRoot metadata)
    {
        var schemas = new Dictionary<string, SchemaAccumulator>(StringComparer.OrdinalIgnoreCase);

        foreach (var (objectType, objectsByName) in metadata.Objects)
        {
            foreach (var databaseObject in objectsByName.Values)
            {
                var schemaName = ResolveSchemaName(databaseObject);
                var schema = GetOrCreateSchema(schemas, schemaName);

                switch (objectType)
                {
                    case DatabaseObjectType.Table:
                        schema.Tables.Add(new ObjectExplorer.ObjectNodeModel(
                            databaseObject.ObjectId,
                            databaseObject.ObjectName,
                            ObjectExplorer.ObjectKind.Table));
                        break;
                    case DatabaseObjectType.View:
                        schema.Views.Add(new ObjectExplorer.ObjectNodeModel(
                            databaseObject.ObjectId,
                            databaseObject.ObjectName,
                            ObjectExplorer.ObjectKind.View));
                        break;
                    case DatabaseObjectType.Procedure:
                        schema.Procedures.Add(new ObjectExplorer.ObjectNodeModel(
                            databaseObject.ObjectId,
                            databaseObject.ObjectName,
                            ObjectExplorer.ObjectKind.Procedure));
                        break;
                    case DatabaseObjectType.Function:
                        schema.Functions.Add(new ObjectExplorer.ObjectNodeModel(
                            databaseObject.ObjectId,
                            databaseObject.ObjectName,
                            ObjectExplorer.ObjectKind.Function));
                        break;
                    case DatabaseObjectType.Trigger:
                        schema.Triggers.Add(new ObjectExplorer.ObjectNodeModel(
                            databaseObject.ObjectId,
                            databaseObject.ObjectName,
                            ObjectExplorer.ObjectKind.Trigger));
                        break;
                    case DatabaseObjectType.Schema:
                        break;
                }
            }
        }

        return schemas
            .OrderBy(schema => schema.Key, StringComparer.OrdinalIgnoreCase)
            .Select(schema => new ObjectExplorer.SchemaNode(
                schema.Key,
                Sort(schema.Value.Tables),
                Sort(schema.Value.Views),
                Sort(schema.Value.Procedures),
                Sort(schema.Value.Functions),
                Sort(schema.Value.Triggers)))
            .ToArray();
    }

    private static SchemaAccumulator GetOrCreateSchema(
        IDictionary<string, SchemaAccumulator> schemas,
        string schemaName)
    {
        if (!schemas.TryGetValue(schemaName, out var schema))
        {
            schema = new SchemaAccumulator();
            schemas[schemaName] = schema;
        }

        return schema;
    }

    private static string ResolveSchemaName(DatabaseObject databaseObject)
    {
        if (databaseObject is SchemaBoundDatabaseObject schemaBoundObject)
        {
            return schemaBoundObject.SchemaName;
        }

        if (databaseObject is SchemaObject schemaObject)
        {
            return schemaObject.ObjectName;
        }

        var dotIndex = databaseObject.FullyQualifiedName.IndexOf('.', StringComparison.Ordinal);
        return dotIndex > 0
            ? databaseObject.FullyQualifiedName[..dotIndex]
            : "default";
    }

    private static IReadOnlyList<ObjectExplorer.ObjectNodeModel> Sort(IEnumerable<ObjectExplorer.ObjectNodeModel> objects)
        => objects
            .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.ObjectId, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private sealed class SchemaAccumulator
    {
        public List<ObjectExplorer.ObjectNodeModel> Tables { get; } = [];
        public List<ObjectExplorer.ObjectNodeModel> Views { get; } = [];
        public List<ObjectExplorer.ObjectNodeModel> Procedures { get; } = [];
        public List<ObjectExplorer.ObjectNodeModel> Functions { get; } = [];
        public List<ObjectExplorer.ObjectNodeModel> Triggers { get; } = [];
    }
}

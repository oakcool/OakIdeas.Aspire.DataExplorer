<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Web.Components\OakIdeas.Aspire.DataExplorer.Web.Components.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Core\OakIdeas.Aspire.DataExplorer.Core.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Contracts\OakIdeas.Aspire.DataExplorer.Contracts.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.Data\OakIdeas.Aspire.DataExplorer.Data.csproj" />
    <ProjectReference Include="..\OakIdeas.Aspire.DataExplorer.SqlServer\OakIdeas.Aspire.DataExplorer.SqlServer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

	<!-- Tailwind CSS build integration -->
	<Target Name="NpmInstallIfNeeded" BeforeTargets="BuildTailwindCss" Inputs="$(MSBuildProjectDirectory)/package.json" Outputs="$(MSBuildProjectDirectory)/node_modules/.package-lock.json">
		<Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<Target Name="BuildTailwindCss" BeforeTargets="Build" Inputs="$(MSBuildProjectDirectory)/Styles/app.css;@(Content)" Outputs="$(MSBuildProjectDirectory)/wwwroot/app.css">
		<Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<ItemGroup>
		<None Include="Styles/**" />
		<Compile Remove="wwwroot\css\**" />
		<Content Remove="wwwroot\css\**" />
		<EmbeddedResource Remove="wwwroot\css\**" />
		<None Remove="wwwroot\css\**" />
		<None Include="package.json" />
	</ItemGroup>

</Project>

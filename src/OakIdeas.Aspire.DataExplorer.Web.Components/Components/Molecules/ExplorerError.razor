@using OakIdeas.Aspire.DataExplorer.Contracts.Models

<div class="explorer-state-stack">
    <ErrorAlert Error="@Error" Message="@ErrorMessage" />
    <ErrorRecovery Error="@Error" />
    <DiagnosticInfo Error="@Error" />
</div>

@code {
    [Parameter]
    public string ErrorMessage { get; set; } = "Unable to load database metadata.";

    [Parameter]
    public DataExplorerError? Error { get; set; }
}

@* Results grid for query/table-browse output *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="results-table">
    @if (IsLoading)
    {
        <div class="results-table__state">
            <LoadingSpinner Label="Fetching results…" />
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="results-table__state">
            <span class="results-table__error">
                <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="16" />
                <span>@ErrorMessage</span>
            </span>
        </div>
    }
    else if (Columns.Count == 0 || Rows.Count == 0)
    {
        <div class="results-table__state">
            <span class="results-table__empty">No results</span>
        </div>
    }
    else
    {
        <div class="results-table__scroll">
            <table class="results-table__grid" @ref="_tableRef">
                <thead>
                    <tr>
                        <th class="results-table__row-num">#</th>
                        @foreach (var col in Columns)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{int rowNum = 1;}
                    @foreach (var row in Rows)
                    {
                        <tr>
                            <td class="results-table__row-num">@rowNum</td>
                            @foreach (var cell in row)
                            {
                                <td title="@cell">@(cell ?? "(null)")</td>
                            }
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="results-table__footer">
        <span class="results-table__count">@Rows.Count row@(Rows.Count != 1 ? "s" : "")@(ElapsedMilliseconds.HasValue ? $" · {ElapsedMilliseconds.Value:F0} ms" : string.Empty)</span>
    </div>
</div>

@code {
    private ElementReference _tableRef;
    private IJSObjectReference? _resizeModule;
    private IJSObjectReference? _resizeInstance;
    private int _lastResizeColumnCount;

    [Parameter]
    public IReadOnlyList<string> Columns { get; set; } = [];

    [Parameter]
    public IReadOnlyList<IReadOnlyList<string?>> Rows { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;

    [Parameter]
    public double? ElapsedMilliseconds { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldEnableResize = !IsLoading && string.IsNullOrEmpty(ErrorMessage) && Columns.Count > 0 && Rows.Count > 0;

        if (!shouldEnableResize)
        {
            await DisposeResizeInstanceAsync();
            return;
        }

        if (_resizeModule is null)
        {
            _resizeModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/OakIdeas.Aspire.DataExplorer.Web.Components/columnResize.js");
        }

        var currentColumns = Columns.Count + 1;
        if (_resizeInstance is null || _lastResizeColumnCount != currentColumns)
        {
            await DisposeResizeInstanceAsync();
            _resizeInstance = await _resizeModule.InvokeAsync<IJSObjectReference>("enableColumnResize", _tableRef);
            _lastResizeColumnCount = currentColumns;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeResizeInstanceAsync();

        if (_resizeModule is not null)
        {
            await _resizeModule.DisposeAsync();
            _resizeModule = null;
        }
    }

    private async ValueTask DisposeResizeInstanceAsync()
    {
        if (_resizeInstance is not null)
        {
            await _resizeInstance.InvokeVoidAsync("dispose");
            await _resizeInstance.DisposeAsync();
            _resizeInstance = null;
            _lastResizeColumnCount = 0;
        }
    }
}

<TreeNode Label="@Schema.Name"
          Icon="HeroIconKind.Folder"
          HasChildren="@Schema.HasAnyObjects"
          Depth="@Depth"
          IsExpanded="@IsExpanded"
          OnExpandToggle="OnExpandToggle">
    @if (Schema.Tables.Any())
    {
        <TreeNode Label="Tables"
                  Icon="HeroIconKind.TableCells"
                  HasChildren="true"
                  Depth="@(Depth + 1)"
                  IsExpanded="@IsGroupExpanded(nameof(Schema.Tables))"
                  OnExpandToggle="@(expanded => ToggleGroup(nameof(Schema.Tables), expanded))">
            @foreach (var table in Schema.Tables)
            {
                <ObjectNode Object="@table"
                            Depth="@(Depth + 2)"
                            IsSelected="@IsSelected(table)"
                            OnSelect="HandleObjectSelected" />
            }
        </TreeNode>
    }

    @if (Schema.Views.Any())
    {
        <TreeNode Label="Views"
                  Icon="HeroIconKind.QueueList"
                  HasChildren="true"
                  Depth="@(Depth + 1)"
                  IsExpanded="@IsGroupExpanded(nameof(Schema.Views))"
                  OnExpandToggle="@(expanded => ToggleGroup(nameof(Schema.Views), expanded))">
            @foreach (var view in Schema.Views)
            {
                <ObjectNode Object="@view"
                            Depth="@(Depth + 2)"
                            IsSelected="@IsSelected(view)"
                            OnSelect="HandleObjectSelected" />
            }
        </TreeNode>
    }

    @if (Schema.Procedures.Any())
    {
        <TreeNode Label="Procedures"
                  Icon="HeroIconKind.Play"
                  HasChildren="true"
                  Depth="@(Depth + 1)"
                  IsExpanded="@IsGroupExpanded(nameof(Schema.Procedures))"
                  OnExpandToggle="@(expanded => ToggleGroup(nameof(Schema.Procedures), expanded))">
            @foreach (var procedure in Schema.Procedures)
            {
                <ObjectNode Object="@procedure"
                            Depth="@(Depth + 2)"
                            IsSelected="@IsSelected(procedure)"
                            OnSelect="HandleObjectSelected" />
            }
        </TreeNode>
    }

    @if (Schema.Functions.Any())
    {
        <TreeNode Label="Functions"
                  Icon="HeroIconKind.CodeBracket"
                  HasChildren="true"
                  Depth="@(Depth + 1)"
                  IsExpanded="@IsGroupExpanded(nameof(Schema.Functions))"
                  OnExpandToggle="@(expanded => ToggleGroup(nameof(Schema.Functions), expanded))">
            @foreach (var function in Schema.Functions)
            {
                <ObjectNode Object="@function"
                            Depth="@(Depth + 2)"
                            IsSelected="@IsSelected(function)"
                            OnSelect="HandleObjectSelected" />
            }
        </TreeNode>
    }

    @if (Schema.Triggers.Any())
    {
        <TreeNode Label="Triggers"
                  Icon="HeroIconKind.Link"
                  HasChildren="true"
                  Depth="@(Depth + 1)"
                  IsExpanded="@IsGroupExpanded(nameof(Schema.Triggers))"
                  OnExpandToggle="@(expanded => ToggleGroup(nameof(Schema.Triggers), expanded))">
            @foreach (var trigger in Schema.Triggers)
            {
                <ObjectNode Object="@trigger"
                            Depth="@(Depth + 2)"
                            IsSelected="@IsSelected(trigger)"
                            OnSelect="HandleObjectSelected" />
            }
        </TreeNode>
    }
</TreeNode>

@code {
    [Parameter, EditorRequired]
    public ObjectExplorer.SchemaNode Schema { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ConnectionName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string DatabaseName { get; set; } = string.Empty;

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; } = true;

    [Parameter]
    public EventCallback<bool> OnExpandToggle { get; set; }

    [Parameter]
    public ObjectExplorer.ObjectSelection? SelectedObject { get; set; }

    [Parameter]
    public EventCallback<ObjectExplorer.ObjectSelection> OnObjectSelect { get; set; }

    private readonly HashSet<string> _collapsedGroups = [];

    private bool IsGroupExpanded(string groupName) => !_collapsedGroups.Contains(groupName);

    private void ToggleGroup(string groupName, bool expanded)
    {
        if (expanded)
        {
            _collapsedGroups.Remove(groupName);
        }
        else
        {
            _collapsedGroups.Add(groupName);
        }
    }

    private bool IsSelected(ObjectExplorer.ObjectNodeModel node)
        => SelectedObject is not null &&
           SelectedObject.SchemaName.Equals(Schema.Name, StringComparison.OrdinalIgnoreCase) &&
           SelectedObject.ObjectId.Equals(node.ObjectId, StringComparison.OrdinalIgnoreCase) &&
           SelectedObject.ObjectKind == node.Kind;

    private async Task HandleObjectSelected(ObjectExplorer.ObjectNodeModel node)
    {
        await OnObjectSelect.InvokeAsync(new ObjectExplorer.ObjectSelection(
            ConnectionName,
            DatabaseName,
            Schema.Name,
            node.ObjectId,
            node.Name,
            node.Kind));
    }
}

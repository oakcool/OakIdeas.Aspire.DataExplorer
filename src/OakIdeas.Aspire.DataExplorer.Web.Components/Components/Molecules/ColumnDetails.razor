@* Renders a table of column metadata for a table or view object *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="column-details">
    @if (Columns is null || Columns.Count == 0)
    {
        <EmptyMetadata Message="No columns available." />
    }
    else
    {
        <div class="column-details__scroll">
            <table class="column-details__grid" @ref="_tableRef">
                <thead>
                    <tr>
                        <th class="column-details__ordinal">#</th>
                        <th>Column</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var col in Columns)
                    {
                        <tr>
                            <td class="column-details__ordinal">@col.Ordinal</td>
                            <td class="column-details__name">
                                <span class="column-details__item-icon" aria-hidden="true">
                                    <HeroIcon Kind="@GetColumnIcon(col)" Size="12" />
                                </span>
                                <span class="column-details__item-name">@col.Name</span>
                                <span class="column-details__item-meta">(@FormatColumnDetails(col))</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="column-details__footer">
            @Columns.Count column@(Columns.Count != 1 ? "s" : "")
        </div>
    }
</div>

@code {
    private ElementReference _tableRef;
    private IJSObjectReference? _resizeModule;
    private IJSObjectReference? _resizeInstance;

    [Parameter]
    public IReadOnlyList<ColumnModel>? Columns { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldEnableResize = Columns is { Count: > 0 };

        if (!shouldEnableResize)
        {
            await DisposeResizeInstanceAsync();
            return;
        }

        if (_resizeModule is null)
        {
            _resizeModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/OakIdeas.Aspire.DataExplorer.Web.Components/columnResize.js");
        }

        if (_resizeInstance is null)
        {
            _resizeInstance = await _resizeModule.InvokeAsync<IJSObjectReference>("enableColumnResize", _tableRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeResizeInstanceAsync();

        if (_resizeModule is not null)
        {
            await _resizeModule.DisposeAsync();
            _resizeModule = null;
        }
    }

    private async ValueTask DisposeResizeInstanceAsync()
    {
        if (_resizeInstance is not null)
        {
            await _resizeInstance.InvokeVoidAsync("dispose");
            await _resizeInstance.DisposeAsync();
            _resizeInstance = null;
        }
    }

    private static HeroIconKind GetColumnIcon(ColumnModel col)
        => (col.IsPrimaryKey, col.IsForeignKey, col.IsIdentity) switch
        {
            (true, _, _) => HeroIconKind.Key,
            (_, true, _) => HeroIconKind.Link,
            (_, _, true) => HeroIconKind.Key,
            _ => HeroIconKind.ViewColumns
        };

    private static string FormatColumnDetails(ColumnModel col)
    {
        var details = new List<string>();
        if (col.IsPrimaryKey) details.Add("PK");
        if (col.IsForeignKey) details.Add("FK");
        if (col.IsIdentity) details.Add("identity");
        if (col.IsComputed) details.Add("computed");
        details.Add(col.DataType);
        details.Add(col.IsNullable ? "null" : "not null");
        if (!string.IsNullOrWhiteSpace(col.DefaultValue))
        {
            details.Add($"default {col.DefaultValue}");
        }

        return string.Join(", ", details);
    }

    public sealed record ColumnModel(
        string Name,
        int Ordinal,
        string DataType,
        bool IsNullable,
        bool IsIdentity,
        bool IsComputed,
        string? DefaultValue,
        bool IsPrimaryKey = false,
        bool IsForeignKey = false);
}

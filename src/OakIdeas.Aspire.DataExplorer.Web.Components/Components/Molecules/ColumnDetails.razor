@* Renders a table of column metadata for a table or view object *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="column-details">
    @if (Columns is null || Columns.Count == 0)
    {
        <EmptyMetadata Message="No columns available." />
    }
    else
    {
        <div class="column-details__scroll">
            <table class="column-details__grid" @ref="_tableRef">
                <thead>
                    <tr>
                        <th class="column-details__ordinal">#</th>
                        <th>Name</th>
                        <th>Data Type</th>
                        <th>Nullable</th>
                        <th>Default</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var col in Columns)
                    {
                        <tr>
                            <td class="column-details__ordinal">@col.Ordinal</td>
                            <td class="column-details__name">
                                @col.Name
                                @if (col.IsIdentity)
                                {
                                    <span class="column-details__tag column-details__tag--identity">ID</span>
                                }
                                @if (col.IsComputed)
                                {
                                    <span class="column-details__tag column-details__tag--computed">CALC</span>
                                }
                            </td>
                            <td class="column-details__type">@col.DataType</td>
                            <td class="column-details__nullable @(col.IsNullable ? "column-details__nullable--yes" : "column-details__nullable--no")">
                                @(col.IsNullable ? "Yes" : "No")
                            </td>
                            <td class="column-details__default">@(col.DefaultValue ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="column-details__footer">
            @Columns.Count column@(Columns.Count != 1 ? "s" : "")
        </div>
    }
</div>

@code {
    private ElementReference _tableRef;
    private IJSObjectReference? _resizeModule;
    private IJSObjectReference? _resizeInstance;

    [Parameter]
    public IReadOnlyList<ColumnModel>? Columns { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldEnableResize = Columns is { Count: > 0 };

        if (!shouldEnableResize)
        {
            await DisposeResizeInstanceAsync();
            return;
        }

        if (_resizeModule is null)
        {
            _resizeModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/OakIdeas.Aspire.DataExplorer.Web.Components/columnResize.js");
        }

        if (_resizeInstance is null)
        {
            _resizeInstance = await _resizeModule.InvokeAsync<IJSObjectReference>("enableColumnResize", _tableRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeResizeInstanceAsync();

        if (_resizeModule is not null)
        {
            await _resizeModule.DisposeAsync();
            _resizeModule = null;
        }
    }

    private async ValueTask DisposeResizeInstanceAsync()
    {
        if (_resizeInstance is not null)
        {
            await _resizeInstance.InvokeVoidAsync("dispose");
            await _resizeInstance.DisposeAsync();
            _resizeInstance = null;
        }
    }

    public sealed record ColumnModel(
        string Name,
        int Ordinal,
        string DataType,
        bool IsNullable,
        bool IsIdentity,
        bool IsComputed,
        string? DefaultValue);
}

@* Renders a list of index metadata for a table object *@
<div class="index-details">
    @if (Indexes is null || Indexes.Count == 0)
    {
        <EmptyMetadata Message="No indexes available." />
    }
    else
    {
        <div class="index-details__scroll">
            <table class="index-details__grid">
                <thead>
                    <tr>
                        <th>Index</th>
                        <th>Columns</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var idx in Indexes)
                    {
                        <tr>
                            <td class="index-details__name">
                                <span class="index-details__icon" aria-hidden="true">
                                    <HeroIcon Kind="@(idx.IsPrimaryKey ? HeroIconKind.Key : HeroIconKind.CircleStack)" Size="12" />
                                </span>
                                <span class="index-details__name-text">@idx.Name</span>
                                <span class="index-details__name-meta">(@FormatIndexDetails(idx))</span>
                            </td>
                            <td class="index-details__columns">@string.Join(", ", idx.Columns)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<IndexModel>? Indexes { get; set; }

    private static string FormatIndexDetails(IndexModel index)
    {
        var details = new List<string>();
        if (index.IsUnique && !index.IsPrimaryKey) details.Add("Unique");
        details.Add(index.IsClustered ? "Clustered" : "Non-clustered");
        return string.Join(", ", details);
    }

    public sealed record IndexModel(
        string Name,
        bool IsPrimaryKey,
        bool IsUnique,
        bool IsClustered,
        IReadOnlyList<string> Columns);
}

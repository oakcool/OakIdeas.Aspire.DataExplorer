@* Displays detailed metadata for a selected database object *@
@if (Selection is null)
{
    <div class="object-details--empty">
        <span class="object-details__empty-icon" aria-hidden="true">
            <HeroIcon Kind="HeroIconKind.TableCells" Size="36" />
        </span>
        <p>Select an object in the explorer to view its details.</p>
    </div>
}
else if (IsLoading)
{
    <div class="object-details__loading">
        <LoadingSpinner Label="Loading object details…" />
    </div>
}
else
{
    @* Use @key to force re-render when the selected object changes *@
    <div @key="@Selection.ObjectId" class="object-details">
        <div class="object-details__header">
            <span class="object-details__icon" aria-hidden="true">
                <HeroIcon Kind="@KindIcon" Size="18" />
            </span>
            <div class="object-details__title-group">
                <span class="object-details__schema">@Selection.SchemaName</span>
                <span class="object-details__sep" aria-hidden="true">.</span>
                <span class="object-details__name">@Selection.ObjectName</span>
            </div>
            <span class="object-details__kind-badge">@KindLabel</span>
        </div>

        <div class="object-details__body">
            @if (Selection.Kind is ObjectKind.Table)
            {
                <MetadataSection Title="Columns" Badge="@(Metadata?.Columns?.Count.ToString() ?? string.Empty)">
                    <ColumnDetails Columns="@Metadata?.Columns" />
                </MetadataSection>

                <MetadataSection Title="Keys" Badge="@(Metadata?.Keys?.Count.ToString() ?? string.Empty)">
                    @if (Metadata?.Keys is { Count: > 0 } keys)
                    {
                        <div class="object-details__constraint-list">
                            @foreach (var key in keys)
                            {
                                <div class="object-details__constraint">
                                    <span class="object-details__meta-icon" aria-hidden="true">
                                        <HeroIcon Kind="HeroIconKind.Key" Size="12" />
                                    </span>
                                    <span class="object-details__constraint-name">@key.KeyName</span>
                                    <span class="object-details__constraint-col">(@(key.Columns.Count > 0 ? string.Join(", ", key.Columns) : "Primary key"))</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No keys defined." />
                    }
                </MetadataSection>

                <MetadataSection Title="Foreign Keys" Badge="@(Metadata?.ForeignKeys?.Count.ToString() ?? string.Empty)">
                    <RelationshipDetails ForeignKeys="@Metadata?.ForeignKeys" />
                </MetadataSection>

                <MetadataSection Title="Indexes" Badge="@(Metadata?.Indexes?.Count.ToString() ?? string.Empty)">
                    <IndexDetails Indexes="@Metadata?.Indexes" />
                </MetadataSection>

                <MetadataSection Title="Constraints" Badge="@(Metadata?.Constraints?.Count.ToString() ?? string.Empty)">
                    @if (Metadata?.Constraints is { Count: > 0 } constraints)
                    {
                        <div class="object-details__constraint-list">
                            @foreach (var constraint in constraints)
                            {
                                <div class="object-details__constraint">
                                    <span class="object-details__meta-icon" aria-hidden="true">
                                        <HeroIcon Kind="HeroIconKind.CheckCircle" Size="12" />
                                    </span>
                                    <span class="object-details__constraint-name">@constraint.ConstraintName</span>
                                    <span class="object-details__constraint-col">(@FormatConstraintDetails(constraint))</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No additional constraints." />
                    }
                </MetadataSection>

                <MetadataSection Title="Triggers" Badge="@(Metadata?.Triggers?.Count.ToString() ?? string.Empty)">
                    @if (Metadata?.Triggers is { Count: > 0 } triggers)
                    {
                        <div class="object-details__param-list">
                            @foreach (var trigger in triggers)
                            {
                                <div class="object-details__param">
                                    <span class="object-details__meta-icon" aria-hidden="true">
                                        <HeroIcon Kind="HeroIconKind.Link" Size="12" />
                                    </span>
                                    <span class="object-details__param-name">@trigger.TriggerName</span>
                                    <span class="object-details__constraint-col">(@FormatTriggerDetails(trigger))</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No triggers defined." />
                    }
                </MetadataSection>
            }
            else if (Selection.Kind is ObjectKind.View)
            {
                <MetadataSection Title="Columns" Badge="@(Metadata?.Columns?.Count.ToString() ?? string.Empty)">
                    <ColumnDetails Columns="@Metadata?.Columns" />
                </MetadataSection>

                <MetadataSection Title="Definition">
                    <DefinitionViewer Definition="@Definition?.Definition"
                                      IsAvailable="@(Definition?.IsAvailable ?? false)"
                                      UnavailableReason="@Definition?.UnavailableReason"
                                      IsLoading="@IsDefinitionLoading" />
                </MetadataSection>
            }
            else if (Selection.Kind is ObjectKind.Procedure)
            {
                <MetadataSection Title="Parameters" Badge="@(Metadata?.Parameters?.Count.ToString() ?? string.Empty)">
                    @if (Metadata?.Parameters is { Count: > 0 } parameters)
                    {
                        <div class="object-details__param-list">
                            @foreach (var param in parameters)
                            {
                                <div class="object-details__param">
                                    <span class="object-details__meta-icon" aria-hidden="true">
                                        <HeroIcon Kind="HeroIconKind.AtSymbol" Size="12" />
                                    </span>
                                    <span class="object-details__param-name">@param.Name</span>
                                    <span class="object-details__constraint-col">(@FormatParameterDetails(param))</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No parameters defined." />
                    }
                </MetadataSection>

                <MetadataSection Title="Definition">
                    <DefinitionViewer Definition="@Definition?.Definition"
                                      IsAvailable="@(Definition?.IsAvailable ?? false)"
                                      UnavailableReason="@Definition?.UnavailableReason"
                                      IsLoading="@IsDefinitionLoading" />
                </MetadataSection>
            }
            else if (Selection.Kind is ObjectKind.Function)
            {
                <MetadataSection Title="Overview">
                    <div class="object-details__function-info">
                        @if (!string.IsNullOrEmpty(Metadata?.FunctionType))
                        {
                            <div class="object-details__info-row">
                                <span class="object-details__info-label">Type</span>
                                <span class="object-details__info-value">@Metadata.FunctionType</span>
                            </div>
                        }
                    </div>
                </MetadataSection>

                <MetadataSection Title="Parameters" Badge="@(Metadata?.Parameters?.Count.ToString() ?? string.Empty)">
                    @if (Metadata?.Parameters is { Count: > 0 } parameters)
                    {
                        <div class="object-details__param-list">
                            @foreach (var param in parameters)
                            {
                                <div class="object-details__param">
                                    <span class="object-details__meta-icon" aria-hidden="true">
                                        <HeroIcon Kind="HeroIconKind.AtSymbol" Size="12" />
                                    </span>
                                    <span class="object-details__param-name">@param.Name</span>
                                    <span class="object-details__constraint-col">(@FormatParameterDetails(param, includeDefault: false))</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No parameters defined." />
                    }
                </MetadataSection>

                <MetadataSection Title="Return Type">
                    @if (!string.IsNullOrEmpty(Metadata?.ReturnType))
                    {
                        <div class="object-details__function-info">
                            <div class="object-details__info-row">
                                <span class="object-details__info-label">Returns</span>
                                <span class="object-details__info-value object-details__info-value--code">@Metadata.ReturnType</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EmptyMetadata Message="No return type metadata available." />
                    }
                </MetadataSection>

                <MetadataSection Title="Definition">
                    <DefinitionViewer Definition="@Definition?.Definition"
                                      IsAvailable="@(Definition?.IsAvailable ?? false)"
                                      UnavailableReason="@Definition?.UnavailableReason"
                                      IsLoading="@IsDefinitionLoading" />
                </MetadataSection>
            }
            else if (Selection.Kind is ObjectKind.Trigger)
            {
                <MetadataSection Title="Details">
                    <div class="object-details__trigger-info">
                        @if (!string.IsNullOrEmpty(Metadata?.TriggerType))
                        {
                            <div class="object-details__info-row">
                                <span class="object-details__info-label">Events</span>
                                <span class="object-details__info-value">@Metadata.TriggerType</span>
                            </div>
                        }
                        @if (Metadata?.TriggerIsEnabled.HasValue == true)
                        {
                            <div class="object-details__info-row">
                                <span class="object-details__info-label">Status</span>
                                <span class="object-details__info-value @(Metadata.TriggerIsEnabled.Value ? "object-details__info-value--enabled" : "object-details__info-value--disabled")">
                                    @(Metadata.TriggerIsEnabled.Value ? "Enabled" : "Disabled")
                                </span>
                            </div>
                        }
                    </div>
                </MetadataSection>

                <MetadataSection Title="Definition">
                    <DefinitionViewer Definition="@Definition?.Definition"
                                      IsAvailable="@(Definition?.IsAvailable ?? false)"
                                      UnavailableReason="@Definition?.UnavailableReason"
                                      IsLoading="@IsDefinitionLoading" />
                </MetadataSection>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public ObjectModel? Selection { get; set; }

    [Parameter]
    public ObjectMetadata? Metadata { get; set; }

    [Parameter]
    public DefinitionModel? Definition { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsDefinitionLoading { get; set; }

    private HeroIconKind KindIcon => Selection?.Kind switch
    {
        ObjectKind.Table => HeroIconKind.TableCells,
        ObjectKind.View => HeroIconKind.QueueList,
        ObjectKind.Procedure => HeroIconKind.Play,
        ObjectKind.Function => HeroIconKind.CodeBracket,
        ObjectKind.Trigger => HeroIconKind.Link,
        _ => HeroIconKind.TableCells,
    };

    private string KindLabel => Selection?.Kind switch
    {
        ObjectKind.Table => "Table",
        ObjectKind.View => "View",
        ObjectKind.Procedure => "Procedure",
        ObjectKind.Function => "Function",
        ObjectKind.Trigger => "Trigger",
        _ => string.Empty,
    };

    private static string FormatConstraintDetails(ConstraintModel constraint)
    {
        var details = new List<string> { constraint.ConstraintKind };
        if (!string.IsNullOrWhiteSpace(constraint.ColumnName))
        {
            details.Add($"on {constraint.ColumnName}");
        }

        if (!string.IsNullOrWhiteSpace(constraint.Definition))
        {
            details.Add(constraint.Definition);
        }

        return string.Join(", ", details);
    }

    private static string FormatTriggerDetails(TriggerModel trigger)
        => $"{trigger.TriggerType}, {(trigger.IsEnabled ? "Enabled" : "Disabled")}";

    private static string FormatParameterDetails(ParameterModel param, bool includeDefault = true)
    {
        var details = new List<string> { param.DataType };
        if (!string.IsNullOrWhiteSpace(param.Direction))
        {
            details.Add(param.Direction);
        }

        if (includeDefault)
        {
            details.Add(param.HasDefault ? "Has default" : "No default");
        }

        return string.Join(", ", details);
    }

    public sealed record ObjectModel(
        string ObjectId,
        string ObjectName,
        string SchemaName,
        string ConnectionName,
        string DatabaseName,
        ObjectKind Kind);

    public sealed record ObjectMetadata(
        IReadOnlyList<ColumnDetails.ColumnModel>? Columns = null,
        IReadOnlyList<KeyModel>? Keys = null,
        IReadOnlyList<IndexDetails.IndexModel>? Indexes = null,
        IReadOnlyList<ConstraintModel>? Constraints = null,
        IReadOnlyList<TriggerModel>? Triggers = null,
        string? TriggerType = null,
        bool? TriggerIsEnabled = null,
        string? FunctionType = null,
        string? ReturnType = null,
        IReadOnlyList<ParameterModel>? Parameters = null,
        IReadOnlyList<RelationshipDetails.ForeignKeyModel>? ForeignKeys = null);

    public sealed record DefinitionModel(
        string? Definition,
        bool IsAvailable,
        string? UnavailableReason = null);

    public sealed record ConstraintModel(
        string ConstraintName,
        string ConstraintKind,
        string? ColumnName,
        string? Definition);

    public sealed record KeyModel(
        string KeyName,
        IReadOnlyList<string> Columns);

    public sealed record TriggerModel(
        string TriggerName,
        string TriggerType,
        bool IsEnabled);

    public sealed record ParameterModel(
        string Name,
        string DataType,
        string? Direction = null,
        bool HasDefault = false);

    public enum ObjectKind
    {
        Table,
        View,
        Procedure,
        Function,
        Trigger,
    }
}

@* Object Explorer panel — tree of connections, databases, schemas, tables *@
<div class="object-explorer @(IsMinimized ? "object-explorer--minimized" : string.Empty)">
    <div class="object-explorer__header">
        @if (IsMinimized)
        {
            <div class="object-explorer__actions object-explorer__actions--collapsed">
                <IconButton Icon="HeroIconKind.ChevronRight"
                            Title=""
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
        else
        {
            <span class="object-explorer__title">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="16" Class="object-explorer__title-icon" />
                <span>Object Explorer</span>
            </span>
            <div class="object-explorer__actions">
                <IconButton Icon="HeroIconKind.ArrowPath" Title="Refresh" Variant="ghost" OnClick="Refresh" />
                <IconButton Icon="HeroIconKind.ChevronLeft"
                            Title="Minimize Object Explorer"
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
    </div>

    @if (IsMinimized)
    {
        <div class="object-explorer__collapsed-body">
            @if (Connections.SelectMany(c => c.Databases).Any())
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.CircleStack" Size="20" />
                </button>
            }
            else if (Connections.Any())
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.ServerStack" Size="20" />
                </button>
            }
        </div>
    }
    else
    {
        <div class="object-explorer__search">
            <div class="object-explorer__search-box">
                <span class="object-explorer__search-icon" aria-hidden="true">
                    <HeroIcon Kind="HeroIconKind.MagnifyingGlass" Size="16" />
                </span>
                <input class="object-explorer__search-input"
                       type="search"
                       placeholder="Filter objects…"
                       @bind="_filter"
                       @bind:event="oninput" />
            </div>
        </div>

        <div class="object-explorer__tree">
            @if (IsLoading)
            {
                <div class="object-explorer__loading">
                    <LoadingSpinner Label="Discovering connections…" />
                </div>
            }
            else if (!Connections.Any())
            {
                <div class="object-explorer__empty">
                    <span>No database connections found.</span>
                    <small>Add a SQL Server resource in your Aspire AppHost.</small>
                </div>
            }
            else
            {
                @foreach (var conn in FilteredConnections)
                {
                    <TreeNode Label="@conn.Name"
                              Icon="HeroIconKind.ServerStack"
                              HasChildren="true"
                              Depth="0"
                              IsExpanded="_expandedConnections.Contains(conn.Name)"
                              OnExpandToggle="@(expanded => ToggleConnection(conn.Name, expanded))"
                              OnSelect="@(() => OnConnectionSelect.InvokeAsync(conn.Name))">
                        @foreach (var db in conn.Databases)
                        {
                            <TreeNode Label="@db.Name"
                                      Icon="HeroIconKind.CircleStack"
                                      HasChildren="@db.Schemas.Any()"
                                      Depth="1"
                                      IsExpanded="_expandedDatabases.Contains(db.Name)"
                                      OnExpandToggle="@(expanded => ToggleDatabase(db.Name, expanded))">
                                @foreach (var schema in db.Schemas)
                                {
                                    <TreeNode Label="@schema.Name"
                                              Icon="HeroIconKind.Folder"
                                              HasChildren="@schema.Tables.Any()"
                                              Depth="2"
                                              IsExpanded="_expandedSchemas.Contains(schema.Name)"
                                              OnExpandToggle="@(expanded => ToggleSchema(schema.Name, expanded))">
                                        @if (schema.Tables.Any())
                                        {
                                            <TreeNode Label="Tables"
                                                      Icon="HeroIconKind.QueueList"
                                                      HasChildren="true"
                                                      Depth="3"
                                                      IsExpanded="_expandedTableGroups.Contains(schema.Name)"
                                                      OnExpandToggle="@(expanded => ToggleTableGroup(schema.Name, expanded))">
                                                @foreach (var table in schema.Tables)
                                                {
                                                    <TreeNode Label="@table"
                                                              Icon="HeroIconKind.TableCells"
                                                              Depth="4"
                                                              IsSelected="_selectedTable == table"
                                                              OnSelect="@(() => SelectTable(conn.Name, schema.Name, table))" />
                                                }
                                            </TreeNode>
                                        }
                                    </TreeNode>
                                }
                            </TreeNode>
                        }
                    </TreeNode>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<ConnectionNode> Connections { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<string> OnConnectionSelect { get; set; }

    [Parameter]
    public EventCallback<TableSelection> OnTableSelect { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool IsMinimized { get; set; }

    [Parameter]
    public EventCallback<bool> OnMinimizeToggle { get; set; }

    private string _filter = string.Empty;
    private string _selectedTable = string.Empty;
    private readonly HashSet<string> _expandedConnections = [];
    private readonly HashSet<string> _expandedDatabases = [];
    private readonly HashSet<string> _expandedSchemas = [];
    private readonly HashSet<string> _expandedTableGroups = [];

    private IEnumerable<ConnectionNode> FilteredConnections =>
        string.IsNullOrWhiteSpace(_filter)
            ? Connections
            : Connections.Where(c =>
                c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                c.Databases.Any(d =>
                    d.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                    d.Schemas.Any(s =>
                        s.Tables.Any(t => t.Contains(_filter, StringComparison.OrdinalIgnoreCase)))));

    private void ToggleConnection(string name, bool expanded)
    {
        if (expanded) _expandedConnections.Add(name); else _expandedConnections.Remove(name);
    }

    private void ToggleDatabase(string name, bool expanded)
    {
        if (expanded) _expandedDatabases.Add(name); else _expandedDatabases.Remove(name);
    }

    private void ToggleSchema(string name, bool expanded)
    {
        if (expanded) _expandedSchemas.Add(name); else _expandedSchemas.Remove(name);
    }

    private void ToggleTableGroup(string name, bool expanded)
    {
        if (expanded) _expandedTableGroups.Add(name); else _expandedTableGroups.Remove(name);
    }

    private async Task SelectTable(string connectionName, string schemaName, string tableName)
    {
        _selectedTable = tableName;
        await OnTableSelect.InvokeAsync(new TableSelection(connectionName, schemaName, tableName));
    }

    private async Task Refresh()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task ToggleMinimized()
    {
        await OnMinimizeToggle.InvokeAsync(!IsMinimized);
    }

    public record ConnectionNode(string Name, IReadOnlyList<DatabaseNode> Databases);
    public record DatabaseNode(string Name, IReadOnlyList<SchemaNode> Schemas);
    public record SchemaNode(string Name, IReadOnlyList<string> Tables);
    public record TableSelection(string ConnectionName, string SchemaName, string TableName);
}

@* Object Explorer panel — tree of connections, databases, and object groups *@
@using OakIdeas.Aspire.DataExplorer.Web.Components.ContextMenu
<div class="object-explorer @(IsMinimized ? "object-explorer--minimized" : string.Empty)">
    <div class="object-explorer__header">
        @if (IsMinimized)
        {
            <div class="object-explorer__actions object-explorer__actions--collapsed">
                <IconButton Icon="HeroIconKind.ChevronRight"
                            Title=""
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
        else
        {
            <span class="object-explorer__title">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="16" Class="object-explorer__title-icon" />
                <span>Object Explorer</span>
            </span>
            <div class="object-explorer__actions">
                <IconButton Icon="HeroIconKind.ArrowPath" Title="Refresh" Variant="ghost" OnClick="Refresh" />
                <IconButton Icon="HeroIconKind.ChevronLeft"
                            Title="Minimize Object Explorer"
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
    </div>

    @if (IsMinimized)
    {
        <div class="object-explorer__collapsed-body">
            @if (HasObjects)
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.CircleStack" Size="20" />
                </button>
            }
            else if (Connections.Any())
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.ServerStack" Size="20" />
                </button>
            }
        </div>
    }
    else
    {
        <div class="object-explorer__tree">
            <ErrorBoundary>
                <ChildContent>
                    @if (IsLoading)
                    {
                        <ExplorerLoading />
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <ExplorerError ErrorMessage="@ErrorMessage" Error="@Error" />
                    }
                    else if (!HasObjects)
                    {
                        <ExplorerEmpty />
                    }
                    else
                    {
                        @foreach (var conn in Connections)
                        {
                            var connectionKey = conn.Name;
                            <TreeNode Label="@conn.Name"
                                      Icon="HeroIconKind.ServerStack"
                                      HasChildren="@conn.Databases.Any(database => database.HasAnyObjects)"
                                      Depth="0"
                                      IsExpanded="@IsConnectionExpanded(connectionKey)"
                                      OnExpandToggle="@(expanded => ToggleConnection(connectionKey, expanded))"
                                      OnSelect="@(() => OnConnectionSelect.InvokeAsync(conn.Name))">
                                @foreach (var db in conn.Databases)
                                {
                                    var databaseKey = $"{conn.Name}/{db.Name}";
                                    <TreeNode Label="@db.Name"
                                              Icon="HeroIconKind.CircleStack"
                                              HasChildren="@db.HasAnyObjects"
                                              Depth="1"
                                              IsExpanded="@IsDatabaseExpanded(databaseKey)"
                                              OnExpandToggle="@(expanded => ToggleDatabase(databaseKey, expanded))">
                                        @foreach (var node in db.Nodes)
                                        {
                                            <ExplorerTreeNode Node="@node"
                                                              Depth="2"
                                                              SelectedObject="@_selectedObject"
                                                              OnObjectSelect="HandleObjectSelect"
                                                              OnObjectContextMenu="HandleContextMenuRequest" />
                                        }
                                    </TreeNode>
                                }
                            </TreeNode>
                        }
                    }
                </ChildContent>
                <ErrorContent>
                    <ExplorerError ErrorMessage="An unexpected error occurred while rendering the metadata tree." />
                </ErrorContent>
            </ErrorBoundary>
        </div>
    }
</div>

<ExplorerContextMenu Items="@_contextMenuItems"
                     IsVisible="@_contextMenuVisible"
                     PositionX="@_contextMenuX"
                     PositionY="@_contextMenuY"
                     OnDismiss="DismissContextMenu" />

@code {
    [Parameter]
    public IReadOnlyList<ConnectionNode> Connections { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public DataExplorerError? Error { get; set; }

    [Parameter]
    public EventCallback<string> OnConnectionSelect { get; set; }

    [Parameter]
    public EventCallback<ObjectSelection> OnObjectSelect { get; set; }

    [Parameter]
    public EventCallback<ExplorerContextAction> OnContextAction { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool IsMinimized { get; set; }

    [Parameter]
    public EventCallback<bool> OnMinimizeToggle { get; set; }

    [Parameter]
    public ObjectSelection? SelectedObject { get; set; }

    private readonly HashSet<string> _collapsedConnections = [];
    private readonly HashSet<string> _collapsedDatabases = [];
    private ObjectSelection? _selectedObject;

    private IReadOnlyList<ExplorerContextMenuItem> _contextMenuItems = [];
    private bool _contextMenuVisible;
    private double _contextMenuX;
    private double _contextMenuY;

    protected override void OnParametersSet()
    {
        if (SelectedObject is not null)
        {
            _selectedObject = SelectedObject;
        }
    }

    private bool HasObjects => Connections
        .SelectMany(connection => connection.Databases)
        .Any(database => database.HasAnyObjects);

    private bool IsConnectionExpanded(string key) => !_collapsedConnections.Contains(key);
    private bool IsDatabaseExpanded(string key) => !_collapsedDatabases.Contains(key);

    private void ToggleConnection(string key, bool expanded)
    {
        if (expanded)
        {
            _collapsedConnections.Remove(key);
        }
        else
        {
            _collapsedConnections.Add(key);
        }
    }

    private void ToggleDatabase(string key, bool expanded)
    {
        if (expanded)
        {
            _collapsedDatabases.Remove(key);
        }
        else
        {
            _collapsedDatabases.Add(key);
        }
    }

    private async Task HandleObjectSelect(ObjectSelection selection)
    {
        _selectedObject = selection;
        await OnObjectSelect.InvokeAsync(selection);
    }

    private void HandleContextMenuRequest(ContextMenuRequest request)
    {
        _contextMenuItems = ExplorerContextMenuBuilder.Build(
            request.Selection,
            action => OnContextAction.InvokeAsync(action));
        _contextMenuX = request.ClientX;
        _contextMenuY = request.ClientY;
        _contextMenuVisible = true;
    }

    private void DismissContextMenu()
    {
        _contextMenuVisible = false;
        _contextMenuItems = [];
    }

    private async Task Refresh()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task ToggleMinimized()
    {
        await OnMinimizeToggle.InvokeAsync(!IsMinimized);
    }

    public record ConnectionNode(string Name, IReadOnlyList<DatabaseNode> Databases);

    public record DatabaseNode(string Name, IReadOnlyList<ExplorerNodeModel> Nodes)
    {
        public bool HasAnyObjects => Nodes.Any();
    }

    public record ExplorerNodeModel(
        string NodeKey,
        string Label,
        HeroIconKind Icon,
        IReadOnlyList<ExplorerNodeModel> Children,
        ObjectSelection? Selection = null)
    {
        public bool HasChildren => Children.Any();
    }

    public record ObjectSelection(
        string ConnectionName,
        string DatabaseName,
        string SchemaName,
        string ObjectId,
        string ObjectName,
        ObjectKind ObjectKind);

    public record ContextMenuRequest(
        ObjectSelection Selection,
        double ClientX,
        double ClientY);

    public enum ObjectKind
    {
        Table,
        View,
        Procedure,
        Function,
        Trigger,
    }
}

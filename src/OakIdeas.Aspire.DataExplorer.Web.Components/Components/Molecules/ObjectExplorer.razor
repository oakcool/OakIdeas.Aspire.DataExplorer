@* Object Explorer panel — tree of connections, databases, and object groups *@
<div class="object-explorer @(IsMinimized ? "object-explorer--minimized" : string.Empty)">
    <div class="object-explorer__header">
        @if (IsMinimized)
        {
            <div class="object-explorer__actions object-explorer__actions--collapsed">
                <IconButton Icon="HeroIconKind.ChevronRight"
                            Title=""
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
        else
        {
            <span class="object-explorer__title">
                <HeroIcon Kind="HeroIconKind.QueueList" Size="16" Class="object-explorer__title-icon" />
                <span>Object Explorer</span>
            </span>
            <div class="object-explorer__actions">
                <IconButton Icon="HeroIconKind.ArrowPath" Title="Refresh" Variant="ghost" OnClick="Refresh" />
                <IconButton Icon="HeroIconKind.ChevronLeft"
                            Title="Minimize Object Explorer"
                            Variant="ghost"
                            OnClick="ToggleMinimized" />
            </div>
        }
    </div>

    @if (IsMinimized)
    {
        <div class="object-explorer__collapsed-body">
            @if (HasObjects)
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.CircleStack" Size="20" />
                </button>
            }
            else if (Connections.Any())
            {
                <button type="button"
                        class="object-explorer__collapsed-db"
                        @onclick="ToggleMinimized">
                    <HeroIcon Kind="HeroIconKind.ServerStack" Size="20" />
                </button>
            }
        </div>
    }
    else
    {
        <div class="object-explorer__tree">
            <ErrorBoundary>
                <ChildContent>
                    @if (IsLoading)
                    {
                        <ExplorerLoading />
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <ExplorerError ErrorMessage="@ErrorMessage" Error="@Error" />
                    }
                    else if (!HasObjects)
                    {
                        <ExplorerEmpty />
                    }
                    else
                    {
                        @foreach (var conn in Connections)
                        {
                            var connectionKey = conn.Name;
                            <TreeNode Label="@conn.Name"
                                      Icon="HeroIconKind.ServerStack"
                                      HasChildren="@conn.Databases.Any(database => database.HasAnyObjects)"
                                      Depth="0"
                                      IsExpanded="@IsConnectionExpanded(connectionKey)"
                                      OnExpandToggle="@(expanded => ToggleConnection(connectionKey, expanded))"
                                      OnSelect="@(() => OnConnectionSelect.InvokeAsync(conn.Name))">
                                @foreach (var db in conn.Databases)
                                {
                                    var databaseKey = $"{conn.Name}/{db.Name}";
                                    <TreeNode Label="@db.Name"
                                              Icon="HeroIconKind.CircleStack"
                                              HasChildren="@db.HasAnyObjects"
                                              Depth="1"
                                              IsExpanded="@IsDatabaseExpanded(databaseKey)"
                                              OnExpandToggle="@(expanded => ToggleDatabase(databaseKey, expanded))">
                                        @if (db.Tables.Any())
                                        {
                                            var groupKey = $"{databaseKey}/tables";
                                            <TreeNode Label="Tables"
                                                      Icon="HeroIconKind.TableCells"
                                                      HasChildren="true"
                                                      Depth="2"
                                                      IsExpanded="@IsGroupExpanded(groupKey)"
                                                      OnExpandToggle="@(expanded => ToggleGroup(groupKey, expanded))">
                                                @foreach (var table in db.Tables)
                                                {
                                                    <ObjectNode Object="@table"
                                                                Depth="3"
                                                                IsSelected="@IsSelected(table)"
                                                                OnSelect="HandleObjectSelect" />
                                                }
                                            </TreeNode>
                                        }

                                        @if (db.Views.Any())
                                        {
                                            var groupKey = $"{databaseKey}/views";
                                            <TreeNode Label="Views"
                                                      Icon="HeroIconKind.QueueList"
                                                      HasChildren="true"
                                                      Depth="2"
                                                      IsExpanded="@IsGroupExpanded(groupKey)"
                                                      OnExpandToggle="@(expanded => ToggleGroup(groupKey, expanded))">
                                                @foreach (var view in db.Views)
                                                {
                                                    <ObjectNode Object="@view"
                                                                Depth="3"
                                                                IsSelected="@IsSelected(view)"
                                                                OnSelect="HandleObjectSelect" />
                                                }
                                            </TreeNode>
                                        }

                                        @if (db.HasProgrammability)
                                        {
                                            var groupKey = $"{databaseKey}/programmability";
                                            <TreeNode Label="Programmability"
                                                      Icon="HeroIconKind.Folder"
                                                      HasChildren="true"
                                                      Depth="2"
                                                      IsExpanded="@IsGroupExpanded(groupKey)"
                                                      OnExpandToggle="@(expanded => ToggleGroup(groupKey, expanded))">
                                                @if (db.StoredProcedures.Any())
                                                {
                                                    var proceduresGroupKey = $"{databaseKey}/programmability/procedures";
                                                    <TreeNode Label="Stored Procedures"
                                                              Icon="HeroIconKind.Play"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(proceduresGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(proceduresGroupKey, expanded))">
                                                        @foreach (var procedure in db.StoredProcedures)
                                                        {
                                                            <ObjectNode Object="@procedure"
                                                                        Depth="4"
                                                                        IsSelected="@IsSelected(procedure)"
                                                                        OnSelect="HandleObjectSelect" />
                                                        }
                                                    </TreeNode>
                                                }

                                                @if (db.Functions.Any())
                                                {
                                                    var functionsGroupKey = $"{databaseKey}/programmability/functions";
                                                    <TreeNode Label="Functions"
                                                              Icon="HeroIconKind.CodeBracket"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(functionsGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(functionsGroupKey, expanded))">
                                                        @foreach (var function in db.Functions)
                                                        {
                                                            <ObjectNode Object="@function"
                                                                        Depth="4"
                                                                        IsSelected="@IsSelected(function)"
                                                                        OnSelect="HandleObjectSelect" />
                                                        }
                                                    </TreeNode>
                                                }

                                                @if (db.Triggers.Any())
                                                {
                                                    var triggersGroupKey = $"{databaseKey}/programmability/triggers";
                                                    <TreeNode Label="Triggers"
                                                              Icon="HeroIconKind.Link"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(triggersGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(triggersGroupKey, expanded))">
                                                        @foreach (var trigger in db.Triggers)
                                                        {
                                                            <ObjectNode Object="@trigger"
                                                                        Depth="4"
                                                                        IsSelected="@IsSelected(trigger)"
                                                                        OnSelect="HandleObjectSelect" />
                                                        }
                                                    </TreeNode>
                                                }
                                            </TreeNode>
                                        }

                                        @if (db.HasSecurity)
                                        {
                                            var groupKey = $"{databaseKey}/security";
                                            <TreeNode Label="Security"
                                                      Icon="HeroIconKind.Folder"
                                                      HasChildren="true"
                                                      Depth="2"
                                                      IsExpanded="@IsGroupExpanded(groupKey)"
                                                      OnExpandToggle="@(expanded => ToggleGroup(groupKey, expanded))">
                                                @if (db.Users.Any())
                                                {
                                                    var usersGroupKey = $"{databaseKey}/security/users";
                                                    <TreeNode Label="Users"
                                                              Icon="HeroIconKind.Folder"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(usersGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(usersGroupKey, expanded))">
                                                        @foreach (var user in db.Users)
                                                        {
                                                            <TreeNode Label="@user.Name"
                                                                      Icon="HeroIconKind.Folder"
                                                                      HasChildren="false"
                                                                      Depth="4" />
                                                        }
                                                    </TreeNode>
                                                }

                                                @if (db.Roles.Any())
                                                {
                                                    var rolesGroupKey = $"{databaseKey}/security/roles";
                                                    <TreeNode Label="Roles"
                                                              Icon="HeroIconKind.Folder"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(rolesGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(rolesGroupKey, expanded))">
                                                        @foreach (var role in db.Roles)
                                                        {
                                                            <TreeNode Label="@role.Name"
                                                                      Icon="HeroIconKind.Folder"
                                                                      HasChildren="false"
                                                                      Depth="4" />
                                                        }
                                                    </TreeNode>
                                                }

                                                @if (db.Schemas.Any())
                                                {
                                                    var schemasGroupKey = $"{databaseKey}/security/schemas";
                                                    <TreeNode Label="Schemas"
                                                              Icon="HeroIconKind.Folder"
                                                              HasChildren="true"
                                                              Depth="3"
                                                              IsExpanded="@IsGroupExpanded(schemasGroupKey)"
                                                              OnExpandToggle="@(expanded => ToggleGroup(schemasGroupKey, expanded))">
                                                        @foreach (var schema in db.Schemas)
                                                        {
                                                            <TreeNode Label="@schema.Name"
                                                                      Icon="HeroIconKind.Folder"
                                                                      HasChildren="false"
                                                                      Depth="4" />
                                                        }
                                                    </TreeNode>
                                                }
                                            </TreeNode>
                                        }
                                    </TreeNode>
                                }
                            </TreeNode>
                        }
                    }
                </ChildContent>
                <ErrorContent>
                    <ExplorerError ErrorMessage="An unexpected error occurred while rendering the metadata tree." />
                </ErrorContent>
            </ErrorBoundary>
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<ConnectionNode> Connections { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public DataExplorerError? Error { get; set; }

    [Parameter]
    public EventCallback<string> OnConnectionSelect { get; set; }

    [Parameter]
    public EventCallback<ObjectSelection> OnObjectSelect { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool IsMinimized { get; set; }

    [Parameter]
    public EventCallback<bool> OnMinimizeToggle { get; set; }

    [Parameter]
    public ObjectSelection? SelectedObject { get; set; }

    private readonly HashSet<string> _collapsedConnections = [];
    private readonly HashSet<string> _collapsedDatabases = [];
    private readonly HashSet<string> _collapsedGroups = [];
    private ObjectSelection? _selectedObject;

    protected override void OnParametersSet()
    {
        if (SelectedObject is not null)
        {
            _selectedObject = SelectedObject;
        }
    }

    private bool HasObjects => Connections
        .SelectMany(connection => connection.Databases)
        .Any(database => database.HasAnyObjects);

    private bool IsConnectionExpanded(string key) => !_collapsedConnections.Contains(key);
    private bool IsDatabaseExpanded(string key) => !_collapsedDatabases.Contains(key);
    private bool IsGroupExpanded(string key) => !_collapsedGroups.Contains(key);

    private void ToggleConnection(string key, bool expanded)
    {
        if (expanded)
        {
            _collapsedConnections.Remove(key);
        }
        else
        {
            _collapsedConnections.Add(key);
        }
    }

    private void ToggleDatabase(string key, bool expanded)
    {
        if (expanded)
        {
            _collapsedDatabases.Remove(key);
        }
        else
        {
            _collapsedDatabases.Add(key);
        }
    }

    private void ToggleGroup(string key, bool expanded)
    {
        if (expanded)
        {
            _collapsedGroups.Remove(key);
        }
        else
        {
            _collapsedGroups.Add(key);
        }
    }

    private bool IsSelected(ObjectNodeModel node)
        => _selectedObject is not null &&
           _selectedObject.ObjectId.Equals(node.ObjectId, StringComparison.OrdinalIgnoreCase) &&
           _selectedObject.ObjectKind == node.Kind;

    private async Task HandleObjectSelect(ObjectNodeModel node)
    {
        var selection = new ObjectSelection(
            node.ConnectionName,
            node.DatabaseName,
            node.SchemaName,
            node.ObjectId,
            node.ObjectName,
            node.Kind);

        _selectedObject = selection;
        await OnObjectSelect.InvokeAsync(selection);
    }

    private async Task Refresh()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task ToggleMinimized()
    {
        await OnMinimizeToggle.InvokeAsync(!IsMinimized);
    }

    public record ConnectionNode(string Name, IReadOnlyList<DatabaseNode> Databases);
    public record DatabaseNode(
        string Name,
        IReadOnlyList<ObjectNodeModel> Tables,
        IReadOnlyList<ObjectNodeModel> Views,
        IReadOnlyList<ObjectNodeModel> StoredProcedures,
        IReadOnlyList<ObjectNodeModel> Functions,
        IReadOnlyList<ObjectNodeModel> Triggers,
        IReadOnlyList<SecurityNodeModel> Users,
        IReadOnlyList<SecurityNodeModel> Roles,
        IReadOnlyList<SecurityNodeModel> Schemas)
    {
        public bool HasSchemaObjects =>
            Tables.Any() ||
            Views.Any() ||
            StoredProcedures.Any() ||
            Functions.Any() ||
            Triggers.Any();

        public bool HasProgrammability =>
            StoredProcedures.Any() ||
            Functions.Any() ||
            Triggers.Any();

        public bool HasSecurity =>
            Users.Any() ||
            Roles.Any() ||
            Schemas.Any();

        public bool HasAnyObjects =>
            HasSchemaObjects ||
            HasSecurity;
    }

    public record ObjectNodeModel(
        string ObjectId,
        string Name,
        string ConnectionName,
        string DatabaseName,
        string SchemaName,
        string ObjectName,
        ObjectKind Kind);

    public record SecurityNodeModel(
        string ObjectId,
        string Name,
        SecurityKind Kind);

    public record ObjectSelection(
        string ConnectionName,
        string DatabaseName,
        string SchemaName,
        string ObjectId,
        string ObjectName,
        ObjectKind ObjectKind);

    public enum ObjectKind
    {
        Table,
        View,
        Procedure,
        Function,
        Trigger,
    }

    public enum SecurityKind
    {
        User,
        Role,
        Schema,
    }
}

@using OakIdeas.Aspire.DataExplorer.Contracts.Models.Explorer

<div class="execution-plan-viewer">
    @if (IsLoading)
    {
        <div class="execution-plan-viewer__state rounded-xl border border-slate-700/60 bg-slate-900/75 px-3 py-2 text-slate-300">
            <LoadingSpinner Label="Loading execution plan…" />
        </div>
    }
    else if (ExecutionPlan is null)
    {
        <div class="execution-plan-viewer__state rounded-xl border border-slate-700/60 bg-slate-900/75 px-3 py-2 text-slate-300">
            <HeroIcon Kind="HeroIconKind.CheckCircle" Size="16" />
            <span>Execution plan is not available for this query or provider.</span>
        </div>
    }
    else if (!ExecutionPlan.IsAvailable || ExecutionPlan.Nodes is null || ExecutionPlan.Nodes.Count == 0)
    {
        <div class="execution-plan-viewer__state rounded-xl border border-slate-700/60 bg-slate-900/75 px-3 py-2 text-slate-300">
            <HeroIcon Kind="HeroIconKind.CheckCircle" Size="16" />
            <span>@(ExecutionPlan.Message ?? "Execution plan is not available for this query or provider.")</span>
        </div>
    }
    else
    {
        <div class="execution-plan-viewer__header rounded-xl border border-slate-700/70 bg-slate-900/80 px-3 py-2 backdrop-blur-sm">
            <StatusBadge Text="@(ExecutionPlan.Provider ?? "Unknown provider")" Variant="info" />
            <span class="ml-2 hidden text-xs text-slate-400 md:inline">@(ExecutionPlan.Nodes.Count) operator@(ExecutionPlan.Nodes.Count == 1 ? string.Empty : "s"). Pan and zoom to explore.</span>
        </div>
        <ExecutionPlanDiagram Nodes="@ExecutionPlan.Nodes"
                              Edges="@ExecutionPlan.Edges"
                              Class="execution-plan-viewer__diagram" />
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public ExecutionPlanResponse? ExecutionPlan { get; set; }
    [Parameter] public EventCallback<string> OnRenderError { get; set; }
}


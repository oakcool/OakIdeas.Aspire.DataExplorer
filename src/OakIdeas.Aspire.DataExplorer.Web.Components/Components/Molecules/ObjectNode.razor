<TreeNode Label="@Object.Name"
          Icon="@Icon"
          Depth="@Depth"
          IsSelected="@IsSelected"
          OnSelect="HandleSelect" />

@code {
    [Parameter, EditorRequired]
    public ObjectExplorer.ObjectNodeModel Object { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<ObjectExplorer.ObjectNodeModel> OnSelect { get; set; }

    private HeroIconKind Icon => Object.Kind switch
    {
        ObjectExplorer.ObjectKind.Table => HeroIconKind.TableCells,
        ObjectExplorer.ObjectKind.View => HeroIconKind.QueueList,
        ObjectExplorer.ObjectKind.Procedure => HeroIconKind.Play,
        ObjectExplorer.ObjectKind.Function => HeroIconKind.CodeBracket,
        ObjectExplorer.ObjectKind.Trigger => HeroIconKind.Link,
        _ => HeroIconKind.TableCells,
    };

    private async Task HandleSelect()
    {
        await OnSelect.InvokeAsync(Object);
    }
}

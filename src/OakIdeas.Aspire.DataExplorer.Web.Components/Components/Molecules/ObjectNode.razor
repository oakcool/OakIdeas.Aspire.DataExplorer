<TreeNode Label="@Object.Label"
          Icon="@Object.Icon"
          Depth="@Depth"
          IsSelected="@IsSelected"
          OnSelect="HandleSelect" />

@code {
    [Parameter, EditorRequired]
    public ObjectExplorer.ExplorerNodeModel Object { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<ObjectExplorer.ObjectSelection> OnSelect { get; set; }

    private async Task HandleSelect()
    {
        if (Object.Selection is not null)
        {
            await OnSelect.InvokeAsync(Object.Selection);
        }
    }
}

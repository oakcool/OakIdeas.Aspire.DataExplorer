@using OakIdeas.Aspire.DataExplorer.Web.Components.Components.Atoms
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="de-diagram @Class" aria-label="Database diagram">
    <div class="de-diagram__toolbar" role="toolbar" aria-label="Diagram controls">
        <div class="de-diagram__toolbar-group">
            <button class="de-diagram__tool-btn"
                    type="button"
                    title="Zoom in"
                    aria-label="Zoom in"
                    @onclick="ZoomInAsync">
                <HeroIcon Kind="HeroIconKind.Plus" Size="14" />
            </button>
            <button class="de-diagram__tool-btn"
                    type="button"
                    title="Zoom out"
                    aria-label="Zoom out"
                    @onclick="ZoomOutAsync">
                <span class="de-diagram__zoom-out-icon" aria-hidden="true">−</span>
            </button>
            <button class="de-diagram__tool-btn"
                    type="button"
                    title="Fit diagram to screen"
                    aria-label="Fit diagram to screen"
                    @onclick="FitAsync">
                <HeroIcon Kind="HeroIconKind.ViewColumns" Size="14" />
            </button>
        </div>
        <div class="de-diagram__toolbar-group">
            <button class="de-diagram__tool-btn"
                    type="button"
                    title="Reset layout"
                    aria-label="Reset layout"
                    @onclick="ResetLayoutAsync">
                <HeroIcon Kind="HeroIconKind.ArrowPath" Size="14" />
                <span class="de-diagram__tool-label hidden md:inline">Reset Layout</span>
            </button>
        </div>
        @if (OnRefresh.HasDelegate)
        {
            <div class="de-diagram__toolbar-group">
                <button class="de-diagram__tool-btn"
                        type="button"
                        title="Refresh diagram"
                        aria-label="Refresh diagram"
                        @onclick="HandleRefreshAsync">
                    <HeroIcon Kind="HeroIconKind.ArrowPath" Size="14" />
                    <span class="de-diagram__tool-label hidden md:inline">Refresh</span>
                </button>
            </div>
        }
        <div class="de-diagram__toolbar-spacer"></div>
        <div class="de-diagram__toolbar-group de-diagram__search-group">
            <HeroIcon Kind="HeroIconKind.MagnifyingGlass" Size="13" Class="de-diagram__search-icon" />
            <input class="de-diagram__search-input"
                   type="search"
                   placeholder="Search entities…"
                   aria-label="Search diagram entities"
                   value="@_searchTerm"
                   @oninput="HandleSearchAsync" />
        </div>
        <div class="de-diagram__toolbar-group">
            <span class="de-diagram__entity-count" aria-live="polite">
                @(_filteredEntityCount > 0 ? $"{_filteredEntityCount} entities" : string.Empty)
            </span>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="de-diagram__loading" role="status" aria-label="Loading diagram">
            <LoadingSpinner />
            <span>Loading diagram…</span>
        </div>
    }
    else if (DiagramData is null || DiagramData.Entities.Count == 0)
    {
        <div class="de-diagram__empty" role="status">
            <HeroIcon Kind="HeroIconKind.ShareNodes" Size="40" Class="de-diagram__empty-icon" />
            <p class="de-diagram__empty-title">No entities to display</p>
            <p class="de-diagram__empty-subtitle">Select a database with tables or views to visualise the schema.</p>
        </div>
    }
    else
    {
        <div class="de-diagram__canvas-wrapper">
            <div class="de-diagram__canvas" @ref="_canvasRef" tabindex="0" aria-label="Diagram canvas"></div>
        </div>
    }
</div>

@code {
    [Parameter] public DiagramModel? DiagramData { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private DiagramModel? _lastRenderedData;
    private string? _searchTerm;
    private int _filteredEntityCount;

    protected override void OnParametersSet()
    {
        _filteredEntityCount = DiagramData?.Entities.Count ?? 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsLoading || DiagramData is null || DiagramData.Entities.Count == 0)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/OakIdeas.Aspire.DataExplorer.Web.Components/Components/Molecules/DatabaseDiagram.razor.js");

            if (!ReferenceEquals(_lastRenderedData, DiagramData))
            {
                _lastRenderedData = DiagramData;
                await _module.InvokeVoidAsync("initDiagram", _canvasRef, DiagramData);
                _filteredEntityCount = DiagramData.Entities.Count;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Ignore JS interop failures in disconnected/test contexts.
        }
    }

    private async Task ZoomInAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("zoomIn", _canvasRef);
        }
    }

    private async Task ZoomOutAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("zoomOut", _canvasRef);
        }
    }

    private async Task FitAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("fitDiagram", _canvasRef);
        }
    }

    private async Task ResetLayoutAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("resetLayout", _canvasRef);
        }
    }

    private async Task HandleRefreshAsync()
    {
        if (OnRefresh.HasDelegate)
        {
            await OnRefresh.InvokeAsync();
        }
    }

    private async Task HandleSearchAsync(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        if (_module is not null)
        {
            var count = await _module.InvokeAsync<int>("filterEntities", _canvasRef, _searchTerm);
            _filteredEntityCount = count;
        }
        else
        {
            _filteredEntityCount = DiagramData?.Entities.Count ?? 0;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyDiagram", _canvasRef);
                await _module.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors in disconnected/test contexts.
            }
        }
    }
}

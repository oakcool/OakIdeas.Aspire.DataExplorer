@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!string.IsNullOrWhiteSpace(_validationError))
{
    <div class="mermaid-diagram__error" role="status">
        <HeroIcon Kind="HeroIconKind.ExclamationTriangle" Size="16" />
        <span>@_validationError</span>
    </div>
}
else
{
    <div class="mermaid-diagram @Class">
        <div class="mermaid-diagram__surface" @ref="_containerRef"></div>
    </div>
}

@code {
    [Parameter] public string? Diagram { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private string? _renderedDiagram;
    private string? _normalizedDiagram;
    private string? _validationError;

    protected override void OnParametersSet()
    {
        _normalizedDiagram = NormalizeMermaidDiagram(Diagram);
        _validationError = ValidateMermaidDiagram(_normalizedDiagram);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(_validationError)
            || string.IsNullOrWhiteSpace(_normalizedDiagram)
            || string.Equals(_renderedDiagram, _normalizedDiagram, StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/OakIdeas.Aspire.DataExplorer.Web.Components/Components/Atoms/MermaidDiagram.razor.js");

            var renderError = _module is null
                ? "Mermaid renderer is unavailable."
                : await _module.InvokeAsync<string?>("renderMermaid", _containerRef, _normalizedDiagram);

            if (!string.IsNullOrWhiteSpace(renderError))
            {
                _validationError = "Unable to render execution plan diagram.";
                StateHasChanged();
                return;
            }

            _renderedDiagram = _normalizedDiagram;
        }
        catch
        {
            _validationError = "Unable to render execution plan diagram.";
            StateHasChanged();
        }
    }

    public static string? ValidateMermaidDiagram(string? diagram)
    {
        if (string.IsNullOrWhiteSpace(diagram))
        {
            return "Execution plan diagram is not available.";
        }

        return null;
    }

    public static string? NormalizeMermaidDiagram(string? diagram)
    {
        if (string.IsNullOrWhiteSpace(diagram))
        {
            return diagram;
        }

        var normalized = diagram.Trim();
        if (!normalized.StartsWith("```", StringComparison.Ordinal))
        {
            return normalized;
        }

        var lines = normalized
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => !line.Equals("```", StringComparison.Ordinal))
            .ToList();

        if (lines.Count == 0)
        {
            return string.Empty;
        }

        if (lines[0].StartsWith("```", StringComparison.Ordinal))
        {
            lines.RemoveAt(0);
        }

        if (lines.Count > 0 && lines[0].Equals("mermaid", StringComparison.OrdinalIgnoreCase))
        {
            lines.RemoveAt(0);
        }

        return string.Join(Environment.NewLine, lines).Trim();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors in disconnected/test contexts.
            }
        }
    }
}

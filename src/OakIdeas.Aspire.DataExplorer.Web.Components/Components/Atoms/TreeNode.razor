@* A single node in the object-explorer tree *@
<div class="tree-node @(IsSelected ? "tree-node--selected" : "")"
    style="padding-left: @(Depth * 16 + LeftInsetPx)px"
     @onclick="HandleClick">
    <button class="tree-node__toggle"
            @onclick:stopPropagation="true"
            @onclick="ToggleExpand"
            style="visibility: @(HasChildren ? "visible" : "hidden")"
            aria-label="@(IsExpanded ? "Collapse" : "Expand")">
        <HeroIcon Kind="@(IsExpanded ? HeroIconKind.ChevronDown : HeroIconKind.ChevronRight)" Size="14" />
    </button>
    <span class="tree-node__icon @(IsPrimaryNodeIcon ? "tree-node__icon--primary" : string.Empty)" aria-hidden="true">
        <HeroIcon Kind="Icon" Size="@IconSize" />
    </span>
    <span class="tree-node__label">@Label</span>
    @if (!string.IsNullOrEmpty(Badge))
    {
        <span class="tree-node__badge">@Badge</span>
    }
</div>

@if (IsExpanded && ChildContent is not null)
{
    @ChildContent
}

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public HeroIconKind Icon { get; set; } = HeroIconKind.TableCells;

    [Parameter]
    public string Badge { get; set; } = string.Empty;

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public bool HasChildren { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnSelect { get; set; }

    [Parameter]
    public EventCallback<bool> OnExpandToggle { get; set; }

    private async Task HandleClick()
    {
        IsSelected = true;
        await OnSelect.InvokeAsync();
    }

    private async Task ToggleExpand()
    {
        IsExpanded = !IsExpanded;
        await OnExpandToggle.InvokeAsync(IsExpanded);
    }

    private int IconSize => IsPrimaryNodeIcon ? 20 : 16;

    private int LeftInsetPx => IsSelected && IsExpanded && IsPrimaryNodeIcon ? 10 : 0;

    private bool IsPrimaryNodeIcon => Icon is HeroIconKind.ServerStack or HeroIconKind.CircleStack;
}

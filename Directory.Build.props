<Project>
  <PropertyGroup>
    <IsPublicNuGetPackage>false</IsPublicNuGetPackage>
    <IsPublicNuGetPackage Condition="'$(MSBuildProjectName)' == 'OakIdeas.Aspire.DataExplorer.Hosting' Or '$(MSBuildProjectName)' == 'OakIdeas.Aspire.DataExplorer.SqlServer'">true</IsPublicNuGetPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPublicNuGetPackage)' == 'true'">
    <Authors>OakIdeas</Authors>
    <Company>OakIdeas</Company>
    <RepositoryUrl>https://github.com/oakcool/OakIdeas.Aspire.DataExplorer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>http://dataexplorer.oakideas.com/</PackageProjectUrl>
    <PackageTags>aspire;data-explorer;sql-server;blazor</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See repository releases at https://github.com/oakcool/OakIdeas.Aspire.DataExplorer/releases.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) OakIdeas contributors</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPublicNuGetPackage)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs\nuget\package-readme.md"
          Pack="true"
          PackagePath="README.md"
          Link="README.md"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)src\OakIdeas.Aspire.DataExplorer.Web\wwwroot\images\logo.png"
          Condition="'$(MSBuildProjectName)' != 'OakIdeas.Aspire.DataExplorer.Web'"
          Pack="true"
          PackagePath="icon.png"
          Link="icon.png"
          Visible="false" />
  </ItemGroup>
</Project>
